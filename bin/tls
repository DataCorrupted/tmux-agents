# ── helpers ──────────────────────────────────────────────────────────────────

def now():
    return int(time.time())


def read(path):
    try:
        with open(path) as f:
            return f.read()
    except OSError:
        return ""


def first_line(text, limit):
    for line in str(text or "").splitlines():
        line = " ".join(line.split()).strip(" *#>-")
        if line:
            return line if len(line) <= limit else line[:limit - 1] + "…"
    return ""


def one_line(text, limit):
    """text on one line and at most limit characters, as it is otherwise."""
    text = " ".join(str(text or "").split())
    return text if len(text) <= limit else text[:limit - 1] + "…"


def tmux(*args, server=None):
    """Run tmux and return its stdout, or None on failure. server=None uses
    TLS_TMUX (tests) or the usual server; pass a list to pick one explicitly."""
    cmd = ["tmux"] + (TMUX_ARGS if server is None else server) + list(args)
    try:
        r = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                           stdin=subprocess.DEVNULL, text=True, timeout=5)
    except (OSError, subprocess.SubprocessError):
        return None
    return r.stdout if r.returncode == 0 else None


# ── platform ─────────────────────────────────────────────────────────────────
# What tls needs from the OS: an ID of this boot, and a process's start time,
# parent, command name and arguments. Linux answers from /proc. macOS has no
# /proc, so tls asks its kernel through libSystem: sysctl for the boot and the
# arguments, proc_pidinfo for the rest. The rest of tls is the same on both.

if sys.platform == "darwin":
    import ctypes
    import struct

    LIBC = ctypes.CDLL("/usr/lib/libSystem.B.dylib")
    LIBC.sysctl.argtypes = (ctypes.POINTER(ctypes.c_int), ctypes.c_uint, ctypes.c_void_p,
                            ctypes.POINTER(ctypes.c_size_t), ctypes.c_void_p, ctypes.c_size_t)
    LIBC.sysctlbyname.argtypes = (ctypes.c_char_p, ctypes.c_void_p,
                                  ctypes.POINTER(ctypes.c_size_t), ctypes.c_void_p, ctypes.c_size_t)
    LIBC.proc_pidinfo.argtypes = (ctypes.c_int, ctypes.c_int, ctypes.c_uint64, ctypes.c_void_p, ctypes.c_int)
    # struct proc_bsdinfo of <sys/proc_info.h>: 12 uint32 fields (the 5th is the
    # parent), comm[16], name[32], 5 uint32 fields, nice, start seconds and microseconds
    BSDINFO = struct.Struct("=12I16s32s5Ii2Q")

    def sysctl(mib, size):
        """The value of sysctl MIB (a name, or a tuple of numbers) in at most
        size bytes, or None on failure."""
        buf, n = ctypes.create_string_buffer(size), ctypes.c_size_t(size)
        if isinstance(mib, str):
            failed = LIBC.sysctlbyname(mib.encode(), buf, ctypes.byref(n), None, 0)
        else:
            failed = LIBC.sysctl((ctypes.c_int * len(mib))(*mib), len(mib), buf, ctypes.byref(n), None, 0)
        return None if failed else ctypes.string_at(buf, n.value)

    ARGMAX = int.from_bytes(sysctl("kern.argmax", 4) or b"", sys.byteorder) or 1 << 20

    def bsdinfo(pid):
        """PID's struct proc_bsdinfo as a tuple, or None if there is no such process."""
        buf = ctypes.create_string_buffer(BSDINFO.size)
        # ctypes would wrap a pid out of range around to a different process
        if isinstance(pid, int) and 0 < pid < 1 << 31 and \
                LIBC.proc_pidinfo(pid, 3, 0, buf, BSDINFO.size) == BSDINFO.size:  # 3: PROC_PIDTBSDINFO
            return BSDINFO.unpack(buf.raw)
        return None

    def boot_id():
        return (sysctl("kern.bootsessionuuid", 64) or b"").rstrip(b"\0").decode()

    def proc_start(pid):
        """Start time of PID in microseconds since the epoch."""
        info = bsdinfo(pid)
        return info[20] * 1000000 + info[21] if info else None

    def proc_info(pid):
        """PID's parent (None if PID is gone), command name and arguments."""
        info = bsdinfo(pid)
        if not info:
            return None, "", []
        # KERN_PROCARGS2: argc, the program's path, NUL padding, the arguments, the environment
        raw = sysctl((1, 49, pid), ARGMAX) or bytes(4)  # CTL_KERN, KERN_PROCARGS2
        argc = int.from_bytes(raw[:4], sys.byteorder)
        args = raw[4:].partition(b"\0")[2].lstrip(b"\0").split(b"\0")[:argc]
        comm = info[12].split(b"\0")[0]
        return info[4], comm.decode(errors="replace"), [a.decode(errors="replace") for a in args]
else:
    def boot_id():
        return read("/proc/sys/kernel/random/boot_id").strip()

    def proc_start(pid):
        """Start time of PID in clock ticks since boot (field 22 of /proc/PID/stat)."""
        try:
            return int(read("/proc/%d/stat" % pid).rsplit(")", 1)[1].split()[19])
        except (IndexError, ValueError, TypeError):
            return None

    def proc_info(pid):
        """PID's parent (None if PID is gone), command name and arguments."""
        try:
            ppid = int(read("/proc/%d/stat" % pid).rsplit(")", 1)[1].split()[1])
        except (IndexError, ValueError):
            ppid = None
        return ppid, read("/proc/%d/comm" % pid).strip(), read("/proc/%d/cmdline" % pid).split("\0")


# ── state store ──────────────────────────────────────────────────────────────

class Lock:
    def __enter__(self):
        import fcntl
        os.makedirs(STATE_DIR, exist_ok=True)
        self.f = open(os.path.join(STATE_DIR, ".lock"), "a")
        fcntl.flock(self.f, fcntl.LOCK_EX)
        return self

    def __exit__(self, *exc):
        self.f.close()


def path_of(sid):
    return os.path.join(STATE_DIR, sid + ".json")


def load(sid):
    try:
        with open(path_of(sid)) as f:
            rec = json.load(f)
    except (OSError, ValueError):
        return None
    return rec if isinstance(rec, dict) else None


def save(rec):
    os.makedirs(STATE_DIR, exist_ok=True)
    tmp = "%s.%d.tmp" % (path_of(rec["session_id"]), os.getpid())
    with open(tmp, "w") as f:
        json.dump(rec, f, indent=1, ensure_ascii=False)
    os.replace(tmp, path_of(rec["session_id"]))


def remove(sid):
    try:
        os.remove(path_of(sid))
    except OSError:
        pass


def records():
    try:
        names = os.listdir(STATE_DIR)
    except OSError:
        return []
    out = []
    for name in names:
        if name.endswith(".json"):
            rec = load(name[:-5])
            if rec and rec.get("session_id") == name[:-5]:
                out.append(rec)
    return out


def set_state(rec, state, reason, event):
    if rec.get("state") != state or "since" not in rec:
        rec["since"] = now()
    rec["state"] = state
    if reason is not None:
        rec["reason"] = reason
    rec["event"] = event
    rec["event_at"] = now()


def pane_server(rec):
    t = rec.get("tmux") or {}
    return ["-S", t["socket"]] if t.get("socket") else None


def sync_tmux(rec):
    """Mirror the state into the agent's pane options and refresh its session
    name and tmux server, in one tmux call against the server the agent runs in."""
    t, server = rec.get("tmux") or {}, pane_server(rec)
    if not t.get("pane") or not server:
        return
    pane = t["pane"]
    out = tmux("display", "-p", "-t", pane, "#{session_name}\t#{window_index}\t#{window_name}\t" + SERVER_ID +
               "\t#{@tls-hooks}", ";", "set", "-p", "-t", pane, "@agent-state", rec.get("state") or "",
               ";", "set", "-p", "-t", pane, "@agent-session", rec["session_id"], server=server)
    if out:
        f = (out.splitlines()[0].split("\t") + [""] * 5)[:5]
        t.update(session=f[0], window=f[1], window_name=f[2], server=f[3])
        if f[4] != hooks_mark():  # a new tmux server, or other hooks: after an update, or a new setting
            register_tmux_hooks(server)


def clear_tmux(rec):
    t, server = rec.get("tmux") or {}, pane_server(rec)
    if t.get("pane") and server:
        tmux("set", "-pu", "-t", t["pane"], "@agent-state", ";",
             "set", "-pu", "-t", t["pane"], "@agent-session", server=server)


# window-layout-changed: keep the layout you made, with its size, but not one
# that tmux made for a new window size or that relayout applied.
KEEP_LAYOUT = ('if -F "#{&&:#{!=:#{window_layout},#{@tls-applied}},#{||:#{==:#{@tls-size},},'
               '#{==:#{@tls-size},#{window_width}x#{window_height}}}}" { set -wF @tls-base "#{window_layout}" ; '
               'set -wF @tls-size "#{window_width}x#{window_height}" ; set -w @tls-applied "" }')


def tmux_hooks():
    """The tmux hooks of tls, as (name, command): `tls seen` when you look at
    a green agent's pane, and with [resize] proportional on, the two that keep
    the proportions of the panes when a window changes size."""
    run = 'if -F "#{==:#{@agent-state},done}" { run-shell -b "%s seen #{pane_id}" }' % shlex.quote(SELF)
    hooks = [(name, run) for name in SEEN_HOOKS]
    if conf("resize", "proportional") == "on":
        hooks += [("window-layout-changed", KEEP_LAYOUT),
                  ("window-resized", 'if -F "#{&&:#{@tls-base},#{>:#{window_panes},1}}" '
                                     '{ run-shell -b "%s relayout #{window_id}" }' % shlex.quote(SELF))]
    return hooks


def hooks_mark():
    """A mark that changes with the hooks: a tmux server with another one in
    @tls-hooks gets the hooks again (sync_tmux)."""
    import zlib
    return "%08x" % zlib.crc32(repr(tmux_hooks()).encode())


def register_tmux_hooks(server=None):
    """Add the hooks of tls (tmux_hooks) to the tmux server, at index [42],
    which keeps them apart from your own hooks; with proportional off, take
    the resize hooks away. Idempotent. A window with splits that has no kept
    layout yet gets its layout of now."""
    args = []
    for name, cmd in tmux_hooks():
        args += [";", "set-hook", "-g", name + "[42]", cmd]
    if conf("resize", "proportional") == "off":
        args += [";", "set-hook", "-gu", "window-layout-changed[42]", ";", "set-hook", "-gu", "window-resized[42]"]
    if tmux(*args[1:], ";", "set", "-g", "@tls-hooks", hooks_mark(), server=server) is None:
        return False
    out = tmux("list-windows", "-a", "-F", "#{window_id}\t#{window_panes}\t#{@tls-size}\t"
               "#{window_width}x#{window_height}\t#{window_layout}", server=server)
    seed = []
    for f in (line.split("\t") for line in (out or "").splitlines()):
        if len(f) == 5 and f[1] != "1" and not f[2]:
            seed += [";", "set", "-w", "-t", f[0], "@tls-base", f[4], ";", "set", "-w", "-t", f[0], "@tls-size", f[3]]
    if seed:
        tmux(*seed[1:], server=server)
    return True


def mark_seen(rec):
    """Green (done) -> grey (idle): you looked at it."""
    with Lock():
        cur = load(rec["session_id"])
        if cur and cur.get("state") == "done":
            set_state(cur, "idle", None, "seen")
            sync_tmux(cur)
            save(cur)


# ── agent state ──────────────────────────────────────────────────────────────

OFFER = re.compile(r"(want me to|would you like me to|should i also|shall i also|do you want me to also"
                   r"|if you'?d? like|happy to|let me know)\b", re.I)
BLOCKER = re.compile(r"\b(yubikey|security key|touch (your|the) key|2fa|two-factor|mfa|re-?authenticate"
                     r"|(log|sign) ?in again|expired (token|credentials|certificate))\b", re.I)


def builtin_classify(text):
    """(verdict, sentence) for a turn's last message: blocked if one of its last
    sentences wants a security key or a login, waiting if it ends on a question
    that isn't just an offer of more work, else done."""
    prose = re.sub(r"```.*?```", " ", text or "", flags=re.S)
    said = [s.strip(" *_>-") for s in re.split(r"(?<=[.!?])\s+|\n+", prose)]
    said = [s for s in said if s][-3:]
    for s in said:
        if BLOCKER.search(s):
            return "blocked", s
    if said and said[-1].endswith("?") and not OFFER.match(said[-1]):
        return "waiting", said[-1]
    return "done", ""


def classify(text):
    """blocked / waiting / done for a turn's last message, and the sentence
    behind it. A tmux-agent-classify file next to this one decides if there is
    one (its classify(text) returns verdict, rule, sentence); else
    builtin_classify does."""
    if os.path.exists(CLASSIFIER):
        try:
            import importlib.machinery
            import importlib.util
            loader = importlib.machinery.SourceFileLoader("agent_classify", CLASSIFIER)
            mod = importlib.util.module_from_spec(importlib.util.spec_from_loader("agent_classify", loader))
            loader.exec_module(mod)
            verdict, _rule, sentence = mod.classify(text)
            return verdict, sentence or ""
        except Exception:
            pass
    return builtin_classify(text)


def agent_pid(name):
    """The nearest ancestor process that is the agent called name: its command,
    or the program in its first two arguments, has that name. None if none."""
    p = os.getppid()
    for _ in range(8):
        if not name or p is None or p <= 1:
            break
        ppid, comm, argv = proc_info(p)
        if comm == name or any(os.path.basename(a) == name or "/" + name in a for a in argv[:2]):
            return p
        p = ppid
    return None


def identify(rec, f, pid):
    """Who and where the agent is: process (for liveness), cwd, transcript, and
    tmux pane, from report f and the reporter's environment."""
    rec.update(host=HOST, boot_id=boot_id(), pid=pid, pid_start=proc_start(pid),
               cwd=f.get("cwd") or rec.get("cwd") or os.getcwd(),
               transcript=f.get("transcript") or rec.get("transcript") or "")
    pane, sock = os.environ.get("TMUX_PANE"), os.environ.get("TMUX", "").split(",")[0]
    if pane and sock:
        old = rec.get("tmux") or {}
        rec["tmux"] = {"socket": sock, "pane": pane}
        if old.get("pane") == pane and old.get("socket") == sock:
            rec["tmux"].update({k: old[k] for k in ("session", "window", "window_name", "server") if k in old})
        rec["where"] = "tmux"
    else:
        rec["tmux"] = None
        # VS Code's agent panel can run an agent in a hidden tmux of its own,
        # without TMUX and with TERM_PROGRAM=tmux; its VSCODE_* variables give it away.
        vscode = os.environ.get("TERM_PROGRAM") == "vscode" or any(k.startswith("VSCODE_") for k in os.environ)
        rec["where"] = "vscode" if vscode else "terminal"
    rec.pop("ended", None)
    rec.pop("resuming_at", None)


# ── reports: the agent-neutral interface (docs/interface.md) ─────────────────

REPORT_FIELDS = ("id", "agent", "state", "summary", "message", "prompt", "name", "title", "pid",
                 "cwd", "resume", "transcript", "start", "end", "event")
REPORT_STATES = {"busy": "working", "working": "working", "waiting": "waiting", "blocked": "blocked",
                 "done": "done", "idle": "idle", "background": "bg", "bg": "bg"}  # -> record state


def report_pid(f, rec):
    """The agent's process: the report's pid, else an ancestor named like the
    agent, else the session's process so far, else the reporter's parent."""
    pid = str(f.get("pid") or "")
    if pid.isdigit():
        return int(pid)
    rec = rec or {}
    return agent_pid(f.get("agent") or rec.get("agent")) or rec.get("pid") or os.getppid()


def apply(rec, f):
    """Apply report f to rec, the record of its session (None: a new session),
    and save it. Caller holds Lock. Returns (record, fresh), fresh when the
    agent's process is new to tls; (None, False) when the report changed
    nothing, ended the session, or came from an agent deleted in ttop."""
    sid = f["id"]
    if rec and rec.get("deleted"):
        if not f.get("start"):
            return None, False  # the dying agent's last reports
        del rec["deleted"]  # it started again after all
    if f.get("end"):
        if rec:
            clear_tmux(rec)
            if f["end"] == "deliberate":
                remove(sid)
            else:  # killed (tmux gone, reboot, closed terminal): keep it resumable
                rec["ended"] = {"reason": str(f["end"]), "at": now()}
                rec["event"], rec["event_at"] = "end", now()
                save(rec)
        return None, False
    pid = report_pid(f, rec)
    fresh = rec is None or bool(f.get("start")) or rec.get("pid") != pid
    if rec is None:
        rec = {"session_id": sid, "created": now()}
    if fresh:
        identify(rec, f, pid)
    before, changed = rec.get("state"), fresh
    texts = {"agent": one_line(f.get("agent"), 40), "name": one_line(f.get("name"), 80),
             "title": one_line(f.get("title"), 120), "prompt": first_line(f.get("prompt"), 160),
             "resume": " ".join(str(f.get("resume") or "").split())}
    for key, value in texts.items():
        if f.get(key) is not None and rec.get(key) != value:
            rec[key], changed = value, True
    if f.get("message") is not None:
        rec["last_message"], changed = first_line(f["message"], 200), True
    state, summary = f.get("state"), f.get("summary")
    if state == "finished":  # the turn is over: its last message tells done, waiting, blocked apart
        state, sentence = classify(f.get("message") or "")
        summary = rec.get("last_message", "") if state == "done" else sentence
    if state in REPORT_STATES:
        state = REPORT_STATES[state]
        if summary is None and state != before:
            summary = ""  # a new state doesn't keep the summary of the old one
        set_state(rec, state, None if summary is None else first_line(summary, 160),
                  f.get("event") or "report")
        changed = True
    elif summary is not None:
        rec["reason"], changed = first_line(summary, 160), True
    if not changed:
        return None, False
    if fresh or rec.get("state") != before:
        sync_tmux(rec)
    save(rec)
    if pane_server(rec):
        save_layout(list_panes(pane_server(rec)), records(), boot_id())
    return rec, fresh


# ── the Claude Code adapter ──────────────────────────────────────────────────

def ask_reason(p):
    if p.get("tool_name") == "ExitPlanMode":
        return "plan ready for approval"
    ti = p.get("tool_input") if isinstance(p.get("tool_input"), dict) else {}
    qs = ti.get("questions")
    if isinstance(qs, list) and qs and isinstance(qs[0], dict):
        return first_line(qs[0].get("question"), 160) or "question"
    return "question"


def tool_summary(p):
    ti = p.get("tool_input") if isinstance(p.get("tool_input"), dict) else {}
    arg = ti.get("command") or ti.get("file_path") or ti.get("url") or ti.get("pattern") or ""
    return first_line("%s %s" % (p.get("tool_name") or "tool", arg), 150)


def claude_fields(ev, p, state):
    """The report a Claude Code hook event makes, given the session's state so
    far: {} when it changes nothing."""
    if ev == "SessionStart":  # compact: the same session goes on as it was
        return {"start": True} if p.get("source") == "compact" else {"start": True, "state": "idle", "event": "start"}
    if ev == "UserPromptSubmit":
        prompt = p.get("prompt") or ""
        f = {"state": "busy", "event": "prompt"}
        if not prompt.lstrip().startswith("<task-notification"):  # a background task finished
            f["prompt"] = prompt
        return f
    if ev == "PreToolUse":  # matcher: AskUserQuestion|ExitPlanMode
        return {"state": "waiting", "summary": ask_reason(p), "event": "ask"}
    if ev == "PermissionRequest":
        if p.get("tool_name") in ("AskUserQuestion", "ExitPlanMode"):
            return {} if state == "waiting" else {"state": "waiting", "summary": ask_reason(p), "event": "ask"}
        return {"state": "waiting", "summary": "permission: " + tool_summary(p), "event": "permission"}
    if ev == "Notification":
        kind = p.get("notification_type") or ""
        if kind in ("permission_prompt", "elicitation_dialog") and state != "waiting":
            return {"state": "waiting", "summary": p.get("message") or "", "event": "notify"}
        if kind == "idle_prompt" and state == "working":  # turn ended without Stop (Esc)
            return {"state": "idle", "event": "idle"}
        return {}
    if ev == "PostToolUse":  # fires on every tool call: only a change counts
        return {} if state == "working" else {"state": "busy", "event": "tool"}
    if ev == "Stop":
        msg = p.get("last_assistant_message") or ""
        running = [t for t in (p.get("background_tasks") or [])
                   if isinstance(t, dict) and t.get("status") == "running"]
        if running:  # Claude goes on by itself when these finish
            what = running[0].get("description") or running[0].get("command") or "task"
            more = " (+%d more)" % (len(running) - 1) if len(running) > 1 else ""
            return {"state": "background", "summary": first_line("background: " + what, 150) + more,
                    "message": msg, "event": "stop"}
        return {"state": "finished", "message": msg, "event": "stop"}
    if ev == "StopFailure":
        os.makedirs(STATE_DIR, exist_ok=True)
        with open(os.path.join(STATE_DIR, "failures.log"), "a") as log:
            log.write("%s %s\n" % (time.strftime("%F %T"), json.dumps(p)[:800]))
        if state != "working":
            return {}  # a background request failed after the turn: not your problem
        err = p.get("error") or p.get("message") or p.get("reason") or "API error"
        return {"state": "blocked", "summary": "turn failed: " + first_line(err, 140), "event": "fail"}
    if ev == "SessionEnd":
        reason = p.get("reason") or ""
        return {"end": "deliberate" if reason in DELIBERATE_END else reason or "killed"}
    return {}


def transcript_titles(path):
    """(name, title) from the end of a Claude transcript: the name /rename
    gave the session, and Claude's own title for the conversation. Claude
    repeats both every few lines, so the last MB is enough."""
    try:
        with open(path, "rb") as f:
            f.seek(0, os.SEEK_END)
            f.seek(max(0, f.tell() - (1 << 20)))
            tail = f.read().decode(errors="ignore")
    except (OSError, TypeError):
        return "", ""
    found = {}
    for key in ("customTitle", "agentName", "aiTitle"):
        at = tail.rfind('"%s":"' % key)  # inside a JSON string it would read \"key\"
        m = re.compile(r'"%s":"((?:[^"\\]|\\.)*)"' % key).match(tail, at) if at >= 0 else None
        if m:
            try:
                found[key] = json.loads('"%s"' % m.group(1)).strip()
            except ValueError:
                pass
    return found.get("customTitle") or found.get("agentName") or "", found.get("aiTitle") or ""


def hook():
    """The Claude Code adapter: a Claude hook event (JSON on stdin) becomes a
    report about its session."""
    raw = sys.stdin.read()
    if os.environ.get("CLAUDE_CODE_ENTRYPOINT", "").startswith("sdk"):
        return  # headless `claude -p` and SDK runs aren't agents you attend to
    p = json.loads(raw)
    sid, ev = p.get("session_id") or "", p.get("hook_event_name") or ""
    if not SID_RE.fullmatch(sid):
        return
    pid = os.environ.get("CLAUDE_PID", "")  # set by some Claude Code launchers
    with Lock():
        rec = load(sid)
        f = claude_fields(ev, p, (rec or {}).get("state"))
        if f and not f.get("end"):
            f["name"], f["title"] = transcript_titles(p.get("transcript_path") or (rec or {}).get("transcript"))
        f.update(id=sid, agent="claude", cwd=p.get("cwd"), transcript=p.get("transcript_path"))
        if pid.isdigit():
            f["pid"] = pid
        rec, fresh = apply(rec, f)


def report_cmd(argv):
    """tls report: one report from any agent, as key=value arguments and/or one
    JSON object on stdin, read when there are no arguments or one is "-"."""
    f = {}
    if not argv or "-" in argv:
        raw = sys.stdin.read().strip()
        obj = json.loads(raw) if raw else {}
        if not isinstance(obj, dict):
            raise ValueError("stdin must hold one JSON object")
        f.update(obj)
    for arg in argv:
        if arg != "-":
            key, sep, value = arg.partition("=")
            if not sep:
                raise ValueError("expected key=value, not %r" % arg)
            f[key] = value
    bad = sorted(set(f) - set(REPORT_FIELDS))
    if bad:
        raise ValueError("unknown field %s; the fields are %s" % (", ".join(bad), ", ".join(REPORT_FIELDS)))
    for key in ("start", "end"):  # flags: "", 0, false and no leave them unset
        if str(f.get(key, "")).lower() in ("", "0", "false", "no"):
            f.pop(key, None)
    f["id"] = str(f.get("id") or "")
    if not SID_RE.fullmatch(f["id"]):
        raise ValueError("id is required: up to 120 letters, digits and _.:-, starting with a letter or digit")
    if f.get("state") is not None and f["state"] not in REPORT_STATES and f["state"] != "finished":
        raise ValueError("state must be busy, waiting, blocked, done, idle, background or finished")
    with Lock():
        rec, fresh = apply(load(f["id"]), f)
    return 0


def seen(pane):
    sid = (tmux("show", "-pqv", "-t", pane, "@agent-session", server=[]) or "").strip()
    rec = load(sid) if SID_RE.fullmatch(sid) else None
    if rec:
        mark_seen(rec)


def guarded(fn, *args):
    """Hooks must never print or fail: log errors instead."""
    try:
        fn(*args)
    except Exception:
        import traceback
        try:
            os.makedirs(STATE_DIR, exist_ok=True)
            with open(os.path.join(STATE_DIR, "errors.log"), "a") as f:
                f.write("%s %s\n%s\n" % (time.strftime("%F %T"), sys.argv[1:], traceback.format_exc()))
        except Exception:
            pass


# ── session structure ────────────────────────────────────────────────────────

PANE_FIELDS = ("socket", "server", "session", "attached", "window_id", "window", "window_name",
               "auto_name", "window_active", "width", "height", "layout", "pane", "index",
               "active", "cwd", "cmd", "start", "title")
PANE_FORMAT = "\t".join(("#{socket_path}", SERVER_ID, "#{session_name}", "#{session_attached}",
                         "#{window_id}", "#{window_index}", "#{window_name}", "#{automatic-rename}",
                         "#{window_active}", "#{window_width}", "#{window_height}", "#{window_layout}",
                         "#{pane_id}", "#{pane_index}", "#{pane_active}", "#{pane_current_path}",
                         "#{pane_current_command}", "#{pane_start_command}", "#{pane_title}"))


def list_panes(server=None):
    """Every pane of the tmux server as a dict of PANE_FIELDS, in session,
    window and pane order; None if there's no server."""
    out = tmux("list-panes", "-a", "-F", PANE_FORMAT, server=server)
    if out is None:
        return None
    n, panes = len(PANE_FIELDS), []
    for line in out.splitlines():
        f = line.split("\t")
        if len(f) >= n:  # the pane title comes last and may hold tabs
            panes.append(dict(zip(PANE_FIELDS, f[:n - 1] + ["\t".join(f[n - 1:])])))
    return panes


def start_command(fmt):
    """A pane's start command, from #{pane_start_command}, which quotes it."""
    try:
        words = shlex.split(fmt or "")
    except ValueError:
        return ""
    return words[0] if len(words) == 1 else " ".join(map(shlex.quote, words))


def is_ttop(cmd):
    """Whether shell command cmd runs ttop (after any VAR=value words), as the
    bar of a preset does."""
    try:
        words = [w for w in shlex.split(cmd or "") if not re.match(r"[A-Za-z_]\w*=", w)]
    except ValueError:
        return False
    return bool(words) and os.path.basename(words[0]) == "ttop"


def ttop_fits(cmd):
    """Whether shell command cmd, which runs ttop, has -f: that ttop sizes its pane itself."""
    try:
        return bool({"-f", "--fit"} & set(shlex.split(cmd or "")))
    except ValueError:
        return False


def structure(panes, agents):
    """{session: {"windows": [...]}} for list_panes() output. A window keeps
    its id, index, name, size and layout string; a pane its id, directory and
    the agent in it (agents maps a pane id to a Claude session id), and, if it
    runs ttop, its start command."""
    out = {}
    for p in panes:
        ws = out.setdefault(p["session"], {"windows": []})["windows"]
        if not ws or ws[-1]["id"] != p["window_id"]:
            ws.append({"id": p["window_id"], "index": p["window"], "name": p["window_name"],
                       "auto": p["auto_name"] == "1", "active": p["window_active"] == "1",
                       "size": [p["width"], p["height"]], "layout": p["layout"], "panes": []})
        pane = {"id": p["pane"], "cwd": p["cwd"], "active": p["active"] == "1", "agent": agents.get(p["pane"])}
        run = start_command(p.get("start"))
        if is_ttop(run):  # the one start command a rebuild runs again: other ones can do harm twice
            pane["run"] = run
        ws[-1]["panes"].append(pane)
    return out


def layouts_path():
    return os.path.join(STATE_DIR, "layouts.json")


def load_layouts():
    """{tmux server: {session: structure}}, as save_layout keeps it."""
    try:
        d = json.loads(read(layouts_path()) or "{}")
    except ValueError:
        return {}
    return d if isinstance(d, dict) else {}


def save_layout(panes, recs, boot):
    """Save the structure of the sessions agents run or ran in, so that a dead
    agent can come back where it was. While an agent that died has lost its
    pane, its session keeps the structure from before. An entry goes once no
    agent record points at its session. Caller holds Lock."""
    if not panes:
        return
    server = panes[0]["server"]
    kept = [r for r in recs if not r.get("deleted")]
    here = [r for r in kept if (r.get("tmux") or {}).get("server") == server]
    agents = {r["tmux"].get("pane"): r["session_id"]  # one alive in a pane wins over one that died there
              for r in sorted(here, key=lambda r: alive(r, boot))}
    dead = {r["session_id"] for r in here if not alive(r, boot)}
    refs = {((r.get("tmux") or {}).get("server"), (r.get("tmux") or {}).get("session")) for r in kept}
    d = load_layouts()
    mine, changed = dict(d.get(server) or {}), False
    for name, st in structure(panes, agents).items():
        old = mine.get(name)
        if (server, name) not in refs or old == st:
            continue
        have = {p["id"] for w in st["windows"] for p in w["panes"]}
        if old and any(p.get("agent") in dead and p["id"] not in have
                       for w in old["windows"] for p in w["panes"]):
            continue
        mine[name], changed = st, True
    if changed:
        d[server] = mine
    for key in list(d):
        for name in list(d[key]):
            if (key, name) not in refs:
                del d[key][name]
                changed = True
        if not d[key]:
            del d[key]
            changed = True
    if changed:
        os.makedirs(STATE_DIR, exist_ok=True)
        tmp = "%s.%d.tmp" % (layouts_path(), os.getpid())
        with open(tmp, "w") as f:
            json.dump(d, f, indent=1, ensure_ascii=False)
        os.replace(tmp, layouts_path())


# ── setup ────────────────────────────────────────────────────────────────────

def tilde(path):
    return "~" + path[len(HOME):] if path.startswith(HOME + os.sep) else path


def rewrite(path, text, stamp):
    """Replace path's contents (through symlinks, keeping its mode), first
    copying it to <path>.bak-tls-<stamp>. Returns the backup path or ''."""
    real, backup = os.path.realpath(path), ""
    if os.path.exists(real):
        backup = path + ".bak-tls-" + stamp
        shutil.copy2(real, backup)
    os.makedirs(os.path.dirname(real), exist_ok=True)
    tmp = "%s.tls-%d.tmp" % (real, os.getpid())
    with open(tmp, "w") as f:
        f.write(text)
    if backup:
        shutil.copymode(real, tmp)
    os.replace(tmp, real)
    return backup


def setup_claude_hooks(stamp):
    path = os.path.join(HOME, ".claude", "settings.json")
    try:
        with open(path) as f:
            text = f.read()
    except FileNotFoundError:
        text = ""
    except OSError as e:
        return "left alone: can't read %s (%s)" % (tilde(path), e.strerror)
    try:
        cfg = json.loads(text) if text.strip() else {}
    except ValueError:
        return "left alone: %s isn't valid JSON" % tilde(path)
    hooks = cfg.setdefault("hooks", {}) if isinstance(cfg, dict) else None
    if not isinstance(hooks, dict) or not all(isinstance(hooks.get(ev, []), list) for ev in HOOK_EVENTS):
        return "left alone: unexpected layout in %s" % tilde(path)
    cmd, added = SELF + " hook", []
    for ev in HOOK_EVENTS:
        groups = hooks.setdefault(ev, [])
        if any(isinstance(h, dict) and re.search(r"(^|/)tls hook$", str(h.get("command", "")).strip())
               for g in groups if isinstance(g, dict) for h in g.get("hooks") or []):
            continue
        group = {"matcher": HOOK_MATCHER[ev]} if ev in HOOK_MATCHER else {}
        group["hooks"] = [{"type": "command", "command": cmd, "timeout": 10}]
        groups.append(group)
        added.append(ev)
    if not added:
        return "already in %s" % tilde(path)
    backup = rewrite(path, json.dumps(cfg, indent=2, ensure_ascii=False) + ("\n" if text.endswith("\n") else ""), stamp)
    return "added for %d events in %s%s" % (len(added), tilde(path), " (backup %s)" % tilde(backup) if backup else "")


def setup_alias(stamp):
    done = []
    for name in (".bashrc", ".bash_aliases", ".zshrc"):
        path = os.path.join(HOME, name)
        text, n = re.subn(r"(?m)^([ \t]*)(alias[ \t]+tls=.*)$",
                          lambda m: "%s# tls is %s: tmux session list with agent status, printed once (ttop: live). Was: %s"
                          % (m.group(1), tilde(SELF), m.group(2)), read(path))
        if n:
            done.append("%s (backup %s)" % (tilde(path), tilde(rewrite(path, text, stamp))))
    if not done:
        return "no tls alias to replace"
    return "commented out alias tls= in %s; open a new shell or run: unalias tls" % ", ".join(done)


def setup():
    """Per-machine wiring. Where a dotfile syncer brings settings.json and
    .bashrc along already, only the tmux step does anything."""
    stamp = time.strftime("%Y%m%d-%H%M%S")
    print("tls setup on %s (%s)" % (HOST.split(".")[0], tilde(SELF)))
    print("  Claude hooks  " + setup_claude_hooks(stamp))
    print("  shell alias   " + setup_alias(stamp))
    print("  tmux hooks    " + ("registered on the running tmux server" if register_tmux_hooks()
                                else "no tmux server running; added when an agent starts in one"))
    found = shutil.which("tls")
    if not found or os.path.realpath(found) != SELF:
        print("  note          `tls` on your PATH is %s, not this file" % (found or "missing"))
    print()
    return one_shot()


# ── view ─────────────────────────────────────────────────────────────────────

def alive(rec, boot):
    pid = rec.get("pid")
    return (rec.get("boot_id") == boot and not rec.get("ended") and isinstance(pid, int)
            and proc_start(pid) == rec.get("pid_start"))


SAVED = {}  # the structure this process saved last: ttop saves only changes


def snapshot():
    boot, t = boot_id(), now()
    panes = list_panes()
    sock, server = (panes[0]["socket"], panes[0]["server"]) if panes else ("", "")
    sessions, by_name = [], {}
    for p in panes or []:
        if p["session"] not in by_name:
            by_name[p["session"]] = {"name": p["session"], "attached": p["attached"] not in ("", "0"),
                                     "agents": []}
            sessions.append(by_name[p["session"]])
    ids = {p["pane"] for p in panes or []}
    live, outside, gone = {}, [], []
    for rec in records():
        if rec.get("host") != HOST:
            continue
        if rec.get("deleted"):  # listed nowhere until its agent is surely gone
            if not alive(rec, boot) and t - int(rec["deleted"]) > DELETED_TTL:
                remove(rec["session_id"])
            continue
        tm = rec.get("tmux") or {}
        if alive(rec, boot):
            if sock and tm.get("socket") == sock and tm.get("pane") in ids:
                live[tm["pane"]] = rec
                if not tm.get("server"):  # recorded before tls kept track of tmux servers
                    with Lock():
                        cur = load(rec["session_id"])
                        if cur and cur.get("tmux"):
                            cur["tmux"]["server"] = tm["server"] = server
                            save(cur)
            else:
                outside.append(rec)
        elif ((rec.get("transcript") and not os.path.exists(rec["transcript"]))
              or t - int(rec.get("event_at") or 0) > conf("agents", "keep-dead-days") * 86400):
            remove(rec["session_id"])  # can't be resumed any more
        else:
            gone.append(rec)
    for p in panes or []:
        rec = live.get(p["pane"])
        if rec or p["cmd"] in conf("agents", "commands"):
            by_name[p["session"]]["agents"].append({"pane": p["pane"], "window": p["window"],
                                                    "index": p["index"], "rec": rec})
    if panes:
        cur = (structure(panes, {}), sorted((pane, r["session_id"]) for pane, r in live.items()))
        if SAVED.get("cur") != cur or t - SAVED.get("at", 0) >= 30:
            with Lock():
                save_layout(panes, records(), boot)
            SAVED.update(cur=cur, at=t)
    outside.sort(key=lambda r: -int(r.get("event_at") or 0))
    gone.sort(key=lambda r: -int(r.get("event_at") or 0))
    return {"server": panes is not None, "sessions": sessions, "outside": outside, "gone": gone,
            "panes": panes or []}


def detail(rec):
    if not rec:
        return "no status yet (starts at its next prompt)"
    st = rec.get("state")
    if st in ("blocked", "waiting", "bg", "done"):
        return rec.get("reason") or rec.get("last_message") or ""
    return "> " + rec["prompt"] if rec.get("prompt") else ""


def label(rec, skip=""):
    """What to call an agent: the name it was given, else the title of its
    conversation, else its kind (claude, codex, ...). skip is a name not worth
    repeating: its session's."""
    rec = rec or {}
    for name in (rec.get("name"), rec.get("title"), rec.get("agent")):
        if name and name != skip:
            return name
    return ""


def ready(recs):
    """The dead agents of recs that aren't on their way back already."""
    t = now()
    return [r for r in recs if t - int(r.get("resuming_at") or 0) >= RESUME_GRACE]


def dead_groups(snap):
    """Dead agents grouped by the tmux session they ran in (one that wasn't in
    tmux is a group of its own), most recent first: [(name, records)]."""
    groups = {}
    for rec in snap["gone"]:
        t = rec.get("tmux") or {}
        key = (t.get("server"), t["session"]) if t.get("session") else rec["session_id"]
        groups.setdefault(key, (t.get("session") or rec.get("where") or "?", []))[1].append(rec)
    return list(groups.values())


BLANK = {"key": "", "name": "", "attached": False, "state": "", "age": None, "label": "",
         "detail": "", "where": "", "action": None}
DEAD = ("dead", "deadsession")


def build_rows(snap, live=False):
    """Rows to draw, and the hotkeys as {key: row index}. A session with one
    agent is one row; a session with none or several has a row of its own and
    a row per agent under it. Dead agents group the same way, by the session
    they ran in. Each row has an id (to find it again after a refresh) and a
    kind: session, agent, outside, dead or deadsession. A row with an action
    is selectable in ttop: ("open", session, pane, record) shows the session
    (at that pane), ("seen", record) marks an agent outside tmux seen, and
    ("restore", records) brings dead agents back. A session's key picks its
    most urgent agent."""
    rows, hotkeys, keys = [], {}, iter(KEYS)
    for s in snap["sessions"]:
        agents, key, head = s["agents"], next(keys, ""), len(rows)
        if len(agents) != 1:
            rows.append(dict(BLANK, id=("session", s["name"]), kind="session", key=key, name=s["name"],
                             attached=s["attached"], action=("open", s["name"], None, None)))
        for a in agents:
            rec = a["rec"]
            row = dict(BLANK, id=("pane", a["pane"]), kind="agent", state=(rec or {}).get("state") or "?",
                       age=(rec or {}).get("since"), label=label(rec), detail=detail(rec),
                       where="%s %s.%s" % (s["name"], a["window"], a["index"]),
                       action=("open", s["name"], a["pane"], rec))
            if len(agents) == 1:  # the session's own row
                row.update(kind="session", key=key, name=s["name"], attached=s["attached"],
                           label=label(rec, s["name"]))
            rows.append(row)
        if key:
            urgency = [URGENCY.get((a["rec"] or {}).get("state") or "?", 9) for a in agents]
            hotkeys[key] = head + (1 + urgency.index(min(urgency)) if len(agents) > 1 else 0)
    if snap["outside"]:
        rows.append({"section": "outside tmux" + (" · enter marks a green one seen" if live else "")})
        for rec in snap["outside"]:
            rows.append(dict(BLANK, id=("outside", rec["session_id"]), kind="outside",
                             name="%s %s" % (rec.get("where") or "?", os.path.basename(rec.get("cwd") or "") or "/"),
                             state=rec.get("state") or "?", age=rec.get("since"), label=label(rec),
                             detail=detail(rec), action=("seen", rec)))
    if snap["gone"]:
        rows.append({"section": "dead (pane closed or machine rebooted) · " +
                     ("enter or its key brings its session back as it was" if live
                      else "bring them back in ttop, or: tls resume all")})
        for name, recs in dead_groups(snap):
            todo = [r for r in ready(recs) if resume_cmd(r)]
            key = next(keys, "") if todo else ""
            act = ("restore", todo) if todo else None if any(map(resume_cmd, recs)) else ("noresume",)
            if key:
                hotkeys[key] = len(rows)
            if len(recs) > 1:
                rows.append(dict(BLANK, id=("deadsession", name), kind="deadsession", key=key, name=name,
                                 action=act, recs=recs))
            for rec in recs:
                resuming = resume_cmd(rec) and rec not in todo
                was = rec.get("state") or "?"  # in the live rows' words: "busy", not "working"
                row = dict(BLANK, id=("dead", rec["session_id"]), kind="dead", state="gone",
                           state_text="resuming…" if resuming else "was " + STATE_TEXT.get(was, was),
                           age=rec.get("event_at"), label=label(rec),
                           detail="> " + rec["prompt"] if rec.get("prompt") else rec.get("reason") or "",
                           where=(rec.get("tmux") or {}).get("session") or "", recs=[rec],
                           action=None if resuming else act if rec in todo else ("noresume",))
                if len(recs) == 1:
                    row.update(key=key, name=name, label=label(rec, skip=name))
                rows.append(row)
    return rows, hotkeys


def char_width(ch):
    if unicodedata.combining(ch):
        return 0
    return 2 if unicodedata.east_asian_width(ch) in "WF" else 1


def fit(s, w):
    if w <= 0:
        return ""
    if sum(map(char_width, s)) <= w:
        return s
    out, n = [], 0
    for ch in s:
        if n + char_width(ch) > w - 1:
            break
        out.append(ch)
        n += char_width(ch)
    return "".join(out) + "…"


def pad(s, w):
    s = fit(s, w)
    return s + " " * (w - sum(map(char_width, s)))


def ago(ts):
    if not ts:
        return ""
    d = max(0, now() - int(ts))
    for unit, size in (("d", 86400), ("h", 3600), ("m", 60)):
        if d >= size:
            return "%d%s" % (d // size, unit)
    return "%ds" % d


BAR = "\033[48;5;237m"  # background of the row selected in ttop


def dim(s, color):
    return "\033[2m%s\033[0m" % s if color else s


def paint(segs, width, color):
    """(text, 256-color, "dim" or None) segments as one line at most width
    columns wide, cut with an ellipsis. Returns the line and the columns left
    over. Colors end with 39m or 22m, not 0m, so a selection bar survives them."""
    out, room = [], width
    for text, hue in segs:
        text = fit(text, room)
        room -= sum(map(char_width, text))
        if color and hue is not None and text:
            text = "\033[2m%s\033[22m" % text if hue == "dim" else "\033[38;5;%dm%s\033[39m" % (hue, text)
        out.append(text)
    return "".join(out), room


STATE_TEXT = {"working": "busy"}  # the status column's word where it isn't the state's name


def width_of(s):
    return sum(map(char_width, s))


def fit_middle(s, w):
    """s cut to w columns in the middle, so names that share a start, and the
    attached mark at the end, stay readable."""
    if width_of(s) <= w or w < 3:
        return fit(s, w)

    def take(chars, room):
        out = []
        for ch in chars:
            room -= char_width(ch)
            if room < 0:
                break
            out.append(ch)
        return out
    return "".join(take(s, w // 2)) + "…" + "".join(reversed(take(reversed(s), (w - 1) // 2)))


def state_word(r):
    return r.get("state_text") or STATE_TEXT.get(r["state"], r["state"])


def columns(rows, width, live):
    """(session name, status, agent name) column widths for rows; the summary
    gets the rest of width. The names get up to 12 columns each, the summary
    then up to 24, then the names grow to their longest (at most 24 and 28),
    and when the summaries are short the names may have their room too. A
    column no row uses takes no room."""
    cells = [r for r in rows if "section" not in r]
    want = {"name": max([4] + [width_of(r["name"]) + r["attached"] for r in cells]),
            "agent": max([0] + [width_of(r["label"]) for r in cells]),
            "summary": max([0] + [width_of(r["detail"]) for r in cells])}
    status = max([0] + [width_of(state_word(r)) for r in cells if r["state"]])
    fixed = (3 if live else 0) + 1 + (status + 3 if status else 0) + (1 if want["agent"] else 0) + 6
    room = max(0, width - fixed)
    w = {"name": min(want["name"], 12), "agent": min(want["agent"], 12)}
    if w["name"] + w["agent"] > room:  # narrower than that: share what there is
        w["name"] = room * w["name"] // (w["name"] + w["agent"])
        w["agent"] = room - w["name"]
    spare = room - w["name"] - w["agent"]
    spare -= min(spare, 24)  # the summary's share
    for key, cap in (("name", 24), ("agent", 28)):
        grow = min(spare, max(0, min(want[key], cap) - w[key]))
        w[key] += grow
        spare -= grow
    extra = max(0, room - w["name"] - w["agent"] - want["summary"])
    for key in ("name", "agent"):
        grow = min(extra, want[key] - w[key])
        w[key] += grow
        extra -= grow
    return w["name"], status, w["agent"]


def row_line(r, cols, width, color, live=False, selected=False):
    """[ttop: selection mark, key] session name, then for an agent its dot and
    status, name, age and summary. A selected row comes back with the bar
    still on, for the caller's \\033[K to extend."""
    name_w, status_w, agent_w = cols
    st = r["state"]
    segs = [("%s%s " % ("▌" if selected else " ", r["key"] or " "), None)] if live else []
    segs.append((pad(fit_middle(r["name"] + ("*" if r["attached"] else ""), name_w), name_w) + " ", None))
    if st:
        segs.append(("%s %s " % (GLYPH.get(st, " "), pad(state_word(r), status_w)), COLOR.get(st)))
        if agent_w:
            segs.append((pad(r["label"], agent_w) + " ", None))
        segs += [("%4s  " % ago(r["age"]), None), (r["detail"], None)]
    text, room = paint(segs, width, color)
    return BAR + text + " " * room if selected and color else text.rstrip()


def columns_v(rows, width, live):
    """Vertical layout: (status, agent name, age) widths for the agent lines of
    rows, one section of the list, so that its columns line up. Everything if
    it fits: the status words and the whole names. Else the status words go
    first (the dot's color says it too), then the names get cut, down to 4
    columns, and then the age goes."""
    cells = [r for r in rows if r["state"]]
    status = max([0] + [width_of(state_word(r)) for r in cells])
    names = max([0] + [width_of(r["label"]) for r in cells])
    room = width - (1 if live else 0) - 2  # after the selection mark, the indent and the dot
    name = names + 1 if names else 0  # a space and the name
    if status + 1 + name + 4 <= room:  # " status", " name", " age"
        return status, names, True
    if name + 4 <= room:
        return 0, names, True
    if room - 5 >= min(4, names):
        return 0, room - 5, True
    return 0, max(0, room - 1), False


def summary_lines(text, width, most=None):
    """A summary wrapped to width for the vertical layout, on `most` lines at
    most, the last one cut with … if there is more. A prompt goes on under its
    text, not under its ">"."""
    if not text.strip():
        return []
    return wrap(text, width, most, "  " if text.startswith("> ") else "")


def row_lines_v(r, cols, width, color, live=False, selected=False, most=1):
    """The vertical layout of row r: a line with [ttop: the selection mark and
    the key, then] the session's name; for an agent, a line with its dot,
    status, name and age, then its summary in a lighter color, on `most` lines
    at most. A selected row has the bar on all its lines."""
    status_w, name_w, show_age = cols
    mark = ("▌" if selected else " ") if live else ""

    def line(segs):
        text, room = paint(segs, width, color)
        return BAR + text + " " * room if selected and color else text.rstrip()
    out = []
    if r["name"]:
        key = (r["key"] or " ") + " " if live else ""
        name = r["name"] + ("*" if r["attached"] else "")
        out.append(line([(mark + key + fit_middle(name, width - width_of(mark + key)), None)]))
    if r["state"]:
        st = r["state"]
        word = " " + pad(state_word(r), status_w) if status_w else ""
        segs = [(mark + " ", None), (GLYPH.get(st, " ") + word + " ", COLOR.get(st))]
        if name_w:
            segs.append((pad(r["label"], name_w) + (" " if show_age else ""), None))
        if show_age:
            segs.append(("%3s" % ago(r["age"]), None))
        out.append(line(segs))
        for text in summary_lines(r["detail"], width - width_of(mark) - 1, most):
            out.append(line([(mark + " ", None), (text, "dim")]))
    return out


def body_lines(rows, width, color, live=False, sel=None, vertical=False, height=0):
    """The lines for rows, and {row index: (first line, last line)} for
    scrolling. Vertical: each section of the list sizes its own columns, a
    section heading keeps only its name, such as "dead", and the summaries
    wrap: on all the lines they need, or on fewer for all of them, down to
    one, until the list fits in height lines (0: no limit)."""
    if vertical:
        cols, part = {}, []
        for i, r in enumerate(rows + [{"section": ""}]):
            if "section" in r:
                cols.update(dict.fromkeys(part, columns_v([rows[j] for j in part], width, live)))
                part = []
            else:
                part.append(i)
    else:
        cols = columns(rows, width, live)

    def draw(most):
        lines, at = [], {}
        for i, r in enumerate(rows):
            if "section" in r:
                head = re.split(r" \(| · ", r["section"])[0] if vertical else r["section"]
                lines += ["", dim(fit("── %s ──" % head, width), color)]
                continue
            new = (row_lines_v(r, cols[i], width, color, live, i == sel, most) if vertical
                   else [row_line(r, cols, width, color, live, i == sel)])
            at[i] = (len(lines), len(lines) + len(new) - 1)
            lines += new
        return lines or [fit("  (no tmux sessions)", width)], at

    room = width - (1 if live else 0) - 1  # a summary line's, after the selection mark and the indent
    most = max([len(summary_lines(r["detail"], room)) for r in rows if vertical and r.get("state")] + [1])
    lines, at = draw(most)
    while height and most > 1 and len(lines) > height:
        most -= 1
        lines, at = draw(most)
    return lines, at


def natural_width(rows):
    """ttop's vertical layout: the columns that show rows with nothing cut,
    as row_lines_v draws them: the session lines, the section headings, and
    in each section the agent lines with whole names and status words. A live
    section keeps room for the longest status word, so that a change of state
    does not resize a fitted pane."""
    longest = max(width_of(STATE_TEXT.get(s, s)) for s in URGENCY)
    widest, cells = 0, []
    for r in rows + [{"section": ""}]:
        if "section" not in r:
            if r["name"]:  # the selection mark, the key and a space, then the name
                widest = max(widest, 3 + width_of(r["name"]) + r["attached"])
            if r["state"]:
                cells.append(r)
            continue
        if cells:  # the end of a section
            status = max([width_of(state_word(c)) for c in cells]
                         + [longest if any(c["kind"] not in DEAD for c in cells) else 0])
            names = max(width_of(c["label"]) for c in cells)
            widest = max(widest, status + names + (9 if names else 8))  # see columns_v
            cells = []
        head = re.split(r" \(| · ", r["section"])[0]
        widest = max(widest, width_of("── %s ──" % head) if head else 0)
    return widest


def title(snap, name, color, width=0, hints=()):
    """name · host · time, a note when there's no tmux server, and the first
    of hints that fits (a short window's key hint). A narrow window drops the
    hint, the host, then the time."""
    clock, note = time.strftime("%H:%M:%S"), [] if snap["server"] else ["no tmux server"]
    heads = ([name, HOST.split(".")[0], clock], [name, clock], [name], [])
    for parts in [h + note + [hint] for hint in hints for h in heads[:2]] + [h + note for h in heads]:
        head = " · ".join(parts)
        if not width or width_of(head) <= width:
            break
    return dim(fit(head, width) if width else head, color)


# ── actions ──────────────────────────────────────────────────────────────────

def inside_tmux():
    return bool(os.environ.get("TMUX")) and not TMUX_ARGS


def open_session(name, pane, rec, leave=None, enter=None):
    """Show session name, at pane if given. Returns an error message or None."""
    if rec:
        mark_seen(rec)
    if pane:
        tmux("select-window", "-t", pane, ";", "select-pane", "-t", pane)
    if inside_tmux():
        return None if tmux("switch-client", "-t", "=" + name) is not None else "couldn't switch to " + name
    if leave:
        leave()
    try:
        rc = subprocess.call(["tmux"] + TMUX_ARGS + ["attach-session", "-t", "=" + name])
    finally:
        if enter:
            enter()
    return "couldn't attach to " + name if rc else None


def safe_name(s):
    return re.sub(r"[^A-Za-z0-9_-]", "-", s).strip("-") or "agent"


def resume_cmd(rec):
    """The command that resumes rec's agent: the one its reports gave, else,
    for Claude, `claude --resume ID` (TLS_CLAUDE picks the command); "" if none."""
    if rec.get("resume"):
        return rec["resume"]
    if rec.get("agent", "claude") == "claude":
        return "%s --resume %s" % (conf("agents", "claude"), rec["session_id"])
    return ""


def type_resume(pane, rec):
    """Type the agent's resume command into pane, and note that it's on its way."""
    tmux("send-keys", "-t", pane, "-l", resume_cmd(rec), ";", "send-keys", "-t", pane, "Enter")
    with Lock():
        cur = load(rec["session_id"]) or rec
        cur["resuming_at"] = now()
        save(cur)


def resume(rec):
    """Resume the agent in a new window of its tmux session, or a new session.
    Returns (session, pane) or (None, error)."""
    name = (rec.get("tmux") or {}).get("session") or safe_name(os.path.basename(rec.get("cwd") or ""))
    cwd = rec.get("cwd") if os.path.isdir(rec.get("cwd") or "") else HOME
    if tmux("has-session", "-t", "=" + name) is not None:
        out = tmux("new-window", "-d", "-P", "-F", "#{pane_id}", "-t", "=" + name + ":", "-c", cwd)
    else:
        out = tmux("new-session", "-d", "-P", "-F", "#{pane_id}", "-s", name, "-c", cwd)
    pane = (out or "").strip()
    if not pane:
        return None, "couldn't create tmux session %s" % name
    type_resume(pane, rec)
    return name, pane


def start_dir(p):
    return p.get("cwd") if os.path.isdir(p.get("cwd") or "") else HOME


def ordered_panes(w):
    """Saved window w's panes in the order its layout string lists them,
    which is the order tmux fills the layout's cells in."""
    leaves = ["%" + n for n in re.findall(r"\d+x\d+,\d+,\d+,(\d+)", w["layout"].split(",", 1)[-1])]
    by_id = {p["id"]: p for p in w["panes"]}
    return [by_id[i] for i in leaves] if sorted(leaves) == sorted(by_id) else w["panes"]


def build_window(w, session, first=False):
    """Create saved window w in session, or as the first window of a new
    session of that name: its panes, in their directories, then its layout.
    Returns (window id, {saved pane id: pane id})."""
    panes = ordered_panes(w)
    run = lambda p: [p["run"]] if p.get("run") else []  # a preset's bar runs ttop again
    args = ["-P", "-F", "#{window_id}\t#{window_index}\t#{pane_id}", "-c", start_dir(panes[0])] + run(panes[0])
    if first:
        out = tmux("new-session", "-d", "-s", session, "-x", w["size"][0], "-y", w["size"][1], *args)
    else:
        out = (tmux("new-window", "-d", "-t", "=%s:%s" % (session, w["index"]), *args)
               or tmux("new-window", "-d", "-t", "=%s:" % session, *args))
    f = (out or "").strip().split("\t")
    if len(f) != 3:
        return None, {}
    win, index, last = f
    if first and index != w["index"]:
        tmux("move-window", "-s", win, "-t", "=%s:%s" % (session, w["index"]))
    made = {panes[0]["id"]: last}
    for p in panes[1:]:
        last = (tmux("split-window", "-d", "-P", "-F", "#{pane_id}", "-t", last, "-c", start_dir(p), *run(p))
                or "").strip()
        if not last:
            break
        made[p["id"]] = last
        tmux("select-layout", "-t", win, "tiled")  # room for the next split
    if len(made) == len(panes):
        tmux("select-layout", "-t", win, w["layout"])
    if not w["auto"]:
        tmux("rename-window", "-t", win, w["name"])
    for p in panes:
        if p["active"] and p["id"] in made:
            tmux("select-pane", "-t", made[p["id"]])
    return win, made


def repair_window(w, todo):
    """Split the lost panes of the agents in todo back into window w, which
    still exists, each next to a saved neighbour; then w's layout, once all
    its panes are back. Returns {saved pane id: pane id}."""
    panes = ordered_panes(w)
    live = (tmux("list-panes", "-t", w["id"], "-F", "#{pane_id}") or "").split()
    made = {p["id"]: p["id"] for p in panes if p["id"] in live}
    for i, p in enumerate(panes):
        if p["id"] in made or p.get("agent") not in todo:
            continue
        before = [made[q["id"]] for q in panes[:i] if q["id"] in made]
        after = [made[q["id"]] for q in panes[i + 1:] if q["id"] in made]
        if before or after:
            where = ["-t", before[-1]] if before else ["-b", "-t", after[0]]
            new = (tmux("split-window", "-d", "-P", "-F", "#{pane_id}", "-c", start_dir(p), *where) or "").strip()
            if new:
                made[p["id"]] = new
    if (tmux("list-panes", "-t", w["id"], "-F", "#{pane_id}") or "").split() == [made.get(p["id"]) for p in panes]:
        tmux("select-layout", "-t", w["id"], w["layout"])
    return made


def rebuild(name, st, todo, same_server):
    """Recreate what's gone of session name from its saved structure st, for
    the dead agents in todo (session ids): the whole session if it's gone
    (other panes come back as shells), else their windows, split back into if
    still there. Returns {session id: pane id} for the agents with a pane."""
    made = {}
    if tmux("has-session", "-t", "=" + name) is None:
        first, active = True, None
        for w in st["windows"]:
            win, m = build_window(w, name, first)
            if win:
                first = False
                made.update(m)
                active = win if w["active"] else active
        if active:
            tmux("select-window", "-t", active)
    else:
        live = set((tmux("list-windows", "-t", "=" + name, "-F", "#{window_id}") or "").split()
                   if same_server else [])
        for w in st["windows"]:
            if any(p.get("agent") in todo for p in w["panes"]):
                made.update(repair_window(w, todo) if w["id"] in live else build_window(w, name)[1])
    return {p["agent"]: made[p["id"]] for w in st["windows"] for p in w["panes"]
            if p.get("agent") in todo and p["id"] in made}


def restore(recs):
    """Bring dead agents back where they were. One whose pane still sits at a
    shell prompt resumes right there; one whose pane is gone gets it back from
    the saved structure (rebuild); any other gets a new window, as before.
    Returns (session, pane) to show, or (None, error)."""
    panes = list_panes() or []
    by_id = {p["pane"]: p for p in panes}
    server = panes[0]["server"] if panes else ""
    layouts, plans, left, shown, err = load_layouts(), {}, [], [], "nothing to bring back"
    for r in recs:
        if not resume_cmd(r):
            continue
        t = r.get("tmux") or {}
        p = by_id.get(t.get("pane")) if t.get("server") == server else None
        st = layouts.get(t.get("server") or "", {}).get(t.get("session") or "")
        if p and p["cmd"] in SHELLS and p["session"] == t.get("session"):
            type_resume(p["pane"], r)  # Claude exited to its shell
            shown.append((p["session"], p["pane"]))
        elif not p and st and any(q.get("agent") == r["session_id"] for w in st["windows"] for q in w["panes"]):
            plans.setdefault((t["server"], t["session"]), []).append(r)
        else:
            left.append(r)
    for (srv, name), group in plans.items():
        made = rebuild(name, layouts[srv][name], {r["session_id"] for r in group}, srv == server)
        for r in group:
            if r["session_id"] in made:
                type_resume(made[r["session_id"]], r)
                shown.append((name, made[r["session_id"]]))
            else:
                left.append(r)
    for r in left:
        name, pane = resume(r)
        if name:
            shown.append((name, pane))
        else:
            err = pane
    return shown[0] if shown else (None, err)


def restore_all(snap):
    """Bring back every dead agent. Returns the sessions brought back."""
    done = []
    for name, recs in dead_groups(snap):
        todo = [r for r in ready(recs) if resume_cmd(r)]
        if todo and restore(todo)[0]:
            done.append(name)
    return done


def plural(n, word):
    return "%d %s%s" % (n, word, "" if n == 1 else "s")


def mark_deleted(recs, deleted=True):
    """Hide records while their agents' panes die: hook() drops their last
    events and snapshot() lists them nowhere."""
    with Lock():
        for rec in recs:
            cur = load(rec["session_id"])
            if cur:
                if deleted:
                    cur["deleted"] = now()
                else:
                    cur.pop("deleted", None)
                save(cur)


def delete(what, args, recs):
    """Run tmux kill-* args, with the records of the agents it kills hidden
    first. Returns a message."""
    mark_deleted(recs)
    if tmux(*args) is None:
        mark_deleted(recs, False)
        return "couldn't delete " + what
    return "deleted " + what


def forget(recs, what):
    for rec in recs:
        remove(rec["session_id"])
    return "forgot " + what


def delete_ask(r, snap):
    """Del on row r: (question, action) for Enter to confirm, or (message,
    None) when there's nothing to delete. An action returns a message."""
    kind, name = r.get("kind"), r.get("name")
    if kind == "session":
        panes = [p["pane"] for p in snap["panes"] if p["session"] == name]
        agents = [a for s in snap["sessions"] if s["name"] == name for a in s["agents"]]
        here = " · this ttop runs there too" if inside_tmux() and os.environ.get("TMUX_PANE") in panes else ""
        return ("delete session %s: %s, %s%s? enter: yes · esc: no"
                % (name, plural(len(panes), "pane"), plural(len(agents), "agent"), here),
                lambda: delete("session " + name, ["kill-session", "-t", "=" + name],
                               [a["rec"] for a in agents if a["rec"]]))
    if kind == "agent":  # named by its name or title, else by where it is
        pane, rec = r["action"][2], r["action"][3]
        who = r["label"] if r["label"] and r["label"] != (rec or {}).get("agent") else r["where"]
        return ("delete agent %s (kills its pane)? enter: yes · esc: no" % who,
                lambda: delete(who, ["kill-pane", "-t", pane], [rec] if rec else []))
    if kind in DEAD:
        recs = r["recs"]
        named = r["label"] if r["label"] != recs[0].get("agent") else ""
        who = ("dead agent " + (name or named or "in " + (r["where"] or "?")) if len(recs) == 1
               else "%d dead agents of %s" % (len(recs), name))
        return "forget %s? enter: yes · esc: no" % who, lambda: forget(recs, who)
    if kind == "outside":
        return "%s isn't in tmux: close it where it runs" % name, None
    return "nothing to delete", None


# Words for new session names (n in ttop, and `t` through `tls new-name`): one per letter.
ADJECTIVES = ("ancient blue calm dark easy fast good happy icy joyful kind lazy mad neat old "
              "pink quick red slow tiny ugly vast warm xtra young zen").split()
NOUNS = ("ant bear cat dog elk finch goat hawk ivy jay kiwi lily mouse newt owl pig quail root "
         "snake tiger urchin viper wolf xray yacht zebra").split()


def session_name(taken):
    """A free name, picked the way `t` picks one: a random adjective that the
    fewest sessions start with, then a random noun that makes a free pair."""
    import random
    taken = set(taken)
    uses = {a: sum(s.startswith(a + "-") for s in taken) for a in ADJECTIVES}
    fewest = min(uses.values())
    adj = random.choice([a for a in ADJECTIVES if uses[a] == fewest])
    free = [n for n in NOUNS if "%s-%s" % (adj, n) not in taken]
    if free:
        return "%s-%s" % (adj, random.choice(free))
    i = 0  # all pairs taken: a number, as `t` does
    while str(i) in taken:
        i += 1
    return str(i)


def window_size():
    """The size of a window shown here: this pane's window inside tmux, else
    the terminal's."""
    if inside_tmux():
        out = (tmux("display", "-p", "-t", os.environ.get("TMUX_PANE", ""), "#{window_width} #{window_height}")
               or "").split()
        if len(out) == 2 and all(n.isdigit() for n in out):
            return int(out[0]), int(out[1])
    size = shutil.get_terminal_size((80, 24))
    return size.columns, size.lines


def cell_size():
    """A cell's width and height in pixels, if tmux knows them, else 1 and 2."""
    cell = (tmux("display", "-p", "#{client_cell_width} #{client_cell_height}") or "").split()
    if len(cell) == 2 and all(n.isdigit() and n != "0" for n in cell):
        return int(cell[0]), int(cell[1])
    return 1, 2


def nested_right(w, h, a, b, bar, cols):
    """The tmux layout of a w x h window with panes a and b side by side, and
    pane bar on the right, cols wide. a and b get a cell of their own, so
    that they share each change of the bar's width; tmux itself puts all
    three in one row, and gives the change to b alone."""
    inner = w - cols - 1
    body = "%dx%d,0,0{%dx%d,0,0{%dx%d,0,0,%s,%dx%d,%d,0,%s},%dx%d,%d,0,%s}" % (
        w, h, inner, h, inner // 2, h, a.lstrip("%"), inner - 1 - inner // 2, h, inner // 2 + 1,
        b.lstrip("%"), cols, h, inner + 1, bar.lstrip("%"))
    return tmux_layout(body)


def tmux_layout(body):
    """A layout string for select-layout: body with tmux's checksum in front."""
    csum = 0
    for ch in body:
        csum = ((csum >> 1) + ((csum & 1) << 15) + ord(ch)) & 0xFFFF
    return "%04x,%s" % (csum, body)


def apply_preset(target):
    """Give window target, which has one pane, the preset layout: a bar with
    ttop -p -f, and the rest split into two panes side by side. A wide window
    gets the bar on the right, with ttop -v; any other window gets it at the
    bottom, with ttop -h ([preset] in the settings). Returns an error message
    or None."""
    out = tmux("display", "-p", "-t", target, "#{window_panes}\t#{window_width}\t#{window_height}\t"
               "#{pane_id}\t#{pane_current_path}")
    f = (out or "").rstrip("\n").split("\t")
    if len(f) != 5 or not all(n.isdigit() for n in f[:3]):
        return "no tmux window %s" % (target or "here")
    (panes, w, h), pane, cwd = map(int, f[:3]), f[3], f[4]
    if panes != 1:
        return "the window has %d panes; a preset needs a window with one" % panes
    which, cols = conf("preset", "layout"), conf("preset", "right-width")
    if which == "auto":  # by the shape, in pixels if tmux knows a cell's size
        cw, ch = cell_size()
        which = ("right" if w * cw >= conf("preset", "wide") * h * ch
                 and w >= cols + 2 * conf("preset", "pane-width") + 2 else "bottom")
    ttop = shlex.quote(os.path.join(os.path.dirname(SELF), "ttop"))
    if os.environ.get("TLS_PRESET"):  # the bar's ttop makes its new sessions the same way
        ttop = "TLS_PRESET=%s %s" % (shlex.quote(os.environ["TLS_PRESET"]), ttop)
    low, high = conf("preset", "bottom-min-lines"), conf("preset", "bottom-max-lines")
    bar = (["-h", "-l", str(cols), ttop + " -v -p -f"] if which == "right"
           else ["-v", "-l", str(max(low, min(high, h // 5))), ttop + " -h -p -f"])
    new = ("split-window", "-d", "-P", "-F", "#{pane_id}", "-t", pane, "-c", cwd)
    side = tmux(*new, *bar)
    if side is None:
        return "no room for the preset's bar"
    second = tmux(*new, "-h")
    if second is None:
        return "no room for the preset's second pane"
    if which == "right":  # at the bottom, the two panes already share a cell
        tmux("select-layout", "-t", pane, nested_right(w, h, pane, second.strip(), side.strip(), cols))
    return None


def add_bar(target, side="right"):
    """ttv (side right) and tth (side bottom): add a bar with ttop, along the
    right edge of window target and [ttv] width columns wide, or along its
    bottom edge and [tth] height lines high. tmux takes the room from all the
    panes, in proportion to their sizes. A window that has such a bar already
    gets it back at its size; a bar on the other side moves here. Returns an
    error message or None."""
    right = side == "right"
    sec, size = ("ttv", conf("ttv", "width")) if right else ("tth", conf("tth", "height"))
    out = tmux("list-panes", "-t", target, "-F", "\t".join((
        "#{window_width}", "#{window_height}", "#{pane_id}", "#{pane_left}", "#{pane_top}", "#{pane_width}",
        "#{pane_height}", "#{pane_start_command}")))
    panes = [line.split("\t", 7) for line in (out or "").splitlines()]
    if not panes or any(len(p) != 8 for p in panes) or not all(n.isdigit() for n in panes[0][:2]):
        return "no tmux window %s" % target
    w, h = map(int, panes[0][:2])
    bars = {}  # where: (pane, has -f, its width or height now), for the panes that run ttop
    for p in panes:
        cmd = start_command(p[7])
        if is_ttop(cmd):
            left, top, pw, ph = map(int, p[3:7])
            where = ("right" if (left + pw, top, ph) == (w, 0, h) and pw < w else
                     "bottom" if (top + ph, left, pw) == (h, 0, w) and ph < h else "other")
            bars.setdefault(where, (p[2], ttop_fits(cmd), pw if right else ph))
    if "other" in bars:
        return "pane %s of the window already runs ttop, but not as a bar; q there closes it" % bars["other"][0]
    if side in bars:  # its size again (tmux keeps the new layout, as after a drag); a bar with -f fits itself
        pane, fits, now = bars[side]
        if not fits and now != size:
            tmux("resize-pane", "-t", pane, "-x" if right else "-y", str(size))
        return None
    if (w if right else h) < conf(sec, "min-window"):
        return "the window is %d %s; a bar needs %d at least" % (
            w if right else h, "columns wide" if right else "lines high", conf(sec, "min-window"))
    for pane, _, _ in bars.values():  # a bar on the other side: it moves here
        tmux("kill-pane", "-t", pane)
    register_tmux_hooks()  # so that the bar keeps its size when the window changes size
    ttop = shlex.quote(os.path.join(os.path.dirname(SELF), "ttop"))
    bar = tmux("split-window", "-d", "-P", "-F", "#{pane_id}", "-f", "-h" if right else "-v", "-l", str(size),
               "-t", target, " ".join((ttop,) + conf(sec, "options")))
    if bar is None:
        return "no room for the bar"
    # In a window split the same way as the bar (side by side, for a bar on
    # the right), tmux puts the bar in the same row as the panes. Then it gives
    # the bar's room, when the bar closes, and each change of the bar's size to
    # the pane next to the bar alone. In a cell of their own, the panes share them.
    cur = parse_layout((tmux("display", "-p", "-t", target, "#{window_layout}") or "").strip())
    if (cur and cur.get("kind") == ("{" if right else "[") and len(cur["cells"]) > 2
            and cur["cells"][-1].get("pane") == int(bar.strip().lstrip("%"))):
        edge = cur["cells"][-1]
        inner = dict(x=0, y=0, kind=cur["kind"], cells=cur["cells"][:-1],
                     w=cur["w"] - edge["w"] - 1 if right else cur["w"], h=cur["h"] if right else cur["h"] - edge["h"] - 1)
        tmux("select-layout", "-t", target, dump_layout(dict(cur, cells=[inner, edge])))
    return None


CELL_RE, PANE_RE = re.compile(r"(\d+)x(\d+),(\d+),(\d+)"), re.compile(r",(\d+)")


def parse_layout(text):
    """A tmux layout string, with its checksum, as a tree of cells: dicts with
    w, h, x and y, and either pane (the pane's number) or kind ("{" side by
    side, "[" one above the other) and cells. None if it does not parse."""
    body, pos = text.partition(",")[2], 0

    def cell():
        nonlocal pos
        m = CELL_RE.match(body, pos)
        if not m:
            raise ValueError(pos)
        pos, c = m.end(), dict(zip("whxy", map(int, m.groups())))
        if body[pos:pos + 1] in ("{", "["):
            c["kind"], c["cells"] = body[pos], []
            while body[pos:pos + 1] in (c["kind"], ","):
                pos += 1
                c["cells"].append(cell())
            if body[pos:pos + 1] != ("}" if c["kind"] == "{" else "]"):
                raise ValueError(pos)
            pos += 1
        else:
            m = PANE_RE.match(body, pos)
            if not m:
                raise ValueError(pos)
            pos, c["pane"] = m.end(), int(m.group(1))
        return c
    try:
        root = cell()
    except (ValueError, RecursionError):
        return None
    return root if pos == len(body) else None


def dump_layout(c):
    """The layout string of a tree from parse_layout, with tmux's checksum."""
    def body(c):
        head = "%dx%d,%d,%d" % (c["w"], c["h"], c["x"], c["y"])
        if "pane" in c:
            return "%s,%d" % (head, c["pane"])
        return head + c["kind"] + ",".join(map(body, c["cells"])) + ("}" if c["kind"] == "{" else "]")
    return tmux_layout(body(c))


def layout_shape(c):
    """The panes of a layout tree in their splits, without the sizes."""
    return c["pane"] if "pane" in c else (c["kind"], tuple(map(layout_shape, c["cells"])))


def layout_panes(c):
    """The pane numbers of a layout tree, left to right and top to bottom."""
    return [c["pane"]] if "pane" in c else [p for k in c["cells"] for p in layout_panes(k)]


def min_size(c, wide):
    """The fewest columns (wide) or lines that cell c needs: 1 for each pane and each border."""
    if "pane" in c:
        return 1
    sizes = [min_size(k, wide) for k in c["cells"]]
    return sum(sizes) + len(sizes) - 1 if (c["kind"] == "{") == wide else max(sizes)


def share(total, weights, mins):
    """total in parts, in proportion to weights, each part at least its min;
    the largest fractions get the columns left over. None if the mins do not fit."""
    if total < sum(mins):
        return None
    parts, free = {}, list(range(len(weights)))
    while True:
        left = total - sum(parts.values())
        wsum = sum(weights[i] for i in free)
        exact = {i: left * weights[i] / wsum for i in free}
        low = [i for i in free if exact[i] < mins[i]]
        if not low:
            break
        parts.update((i, mins[i]) for i in low)
        free = [i for i in free if i not in low]
    whole = {i: int(exact[i]) for i in free}
    for i in sorted(free, key=lambda i: whole[i] - exact[i])[:left - sum(whole.values())]:
        whole[i] += 1
    parts.update(whole)
    return [parts[i] for i in range(len(weights))]


def scale_layout(c, w, h, bars, x=0, y=0):
    """Layout tree c resized to w x h at x, y: the cells of each split share
    its room in proportion to their old sizes. A ttop bar (bars: pane number
    to whether it has -f) keeps its size along its split while the other cells
    have room, but a bar without -f, such as ttv's or tth's, changes in
    proportion too, within [ttv] min-width and max-width in a row, or [tth]
    min-height and max-height in a column. None if the panes do not fit."""
    out = dict(c, w=w, h=h, x=x, y=y)
    if "pane" in c:
        return out
    wide, kids = c["kind"] == "{", c["cells"]
    room = (w if wide else h) - (len(kids) - 1)
    ratio = room / ((c["w"] if wide else c["h"]) - (len(kids) - 1))
    dim, (low, high) = ("w", "h")[not wide], ((conf("ttv", "min-width"), conf("ttv", "max-width")) if wide
                                              else (conf("tth", "min-height"), conf("tth", "max-height")))
    keep = [None if k.get("pane") not in bars else k[dim] if bars[k["pane"]]
            else max(low, min(high, int(k[dim] * ratio + 0.5))) for k in kids]
    mins = [min_size(k, wide) for k in kids]
    flex = [i for i, n in enumerate(keep) if n is None]
    if not flex or sum(n for n in keep if n) + sum(mins[i] for i in flex) > room:
        keep, flex = [None] * len(kids), list(range(len(kids)))  # no room to keep them: all in proportion
    parts = share(room - sum(n for n in keep if n), [kids[i]["w" if wide else "h"] for i in flex],
                  [mins[i] for i in flex])
    if parts is None:
        return None
    for i, n in zip(flex, parts):
        keep[i] = n
    out["cells"], at = [], x if wide else y
    for k, n in zip(kids, keep):
        kid = scale_layout(k, n, h, bars, at, y) if wide else scale_layout(k, w, n, bars, x, at)
        if kid is None:
            return None
        out["cells"].append(kid)
        at += n + 1
    return out


def relayout(window):
    """window-resized hook: give the panes of window the proportions of the
    last layout you made there (@tls-base), at the window's new size."""
    if conf("resize", "proportional") == "off":
        return
    out = tmux("list-panes", "-t", window, "-F", "\t".join((
        "#{window_width}", "#{window_height}", "#{window_zoomed_flag}", "#{window_layout}", "#{@tls-base}",
        "#{pane_id}", "#{pane_start_command}")), server=[])
    rows = [line.split("\t", 6) for line in (out or "").splitlines()]
    if not rows or any(len(r) != 7 for r in rows) or not (rows[0][0].isdigit() and rows[0][1].isdigit()):
        return
    (w, h), zoomed, now, base = map(int, rows[0][:2]), rows[0][2], rows[0][3], rows[0][4]
    cur, old, size = parse_layout(now), parse_layout(base), "%dx%d" % (w, h)
    if zoomed == "1" or cur is None or layout_panes(cur) != [int(r[5].lstrip("%")) for r in rows]:
        return  # tmux puts panes in layout cells in its own order of them: they must agree
    if old is None or layout_shape(old) != layout_shape(cur):  # the splits changed: start again from these
        tmux("set", "-w", "-t", window, "@tls-base", now, ";", "set", "-w", "-t", window, "@tls-size", size,
             server=[])
        return
    bars = {int(r[5].lstrip("%")): ttop_fits(start_command(r[6])) for r in rows if is_ttop(start_command(r[6]))}
    new = scale_layout(old, w, h, bars)
    if new is None:
        return
    # Only at the size it is for: tmux resizes the window to a layout of another size.
    tmux("if-shell", "-F", "-t", window, "#{==:#{window_width}x#{window_height},%s}" % size,
         "select-layout -t %s '%s' ; set -wF -t %s @tls-applied '#{window_layout}' ; set -w -t %s @tls-size %s"
         % (window, dump_layout(new), window, window, size), server=[])


def new_session(preset=False):
    """Create a detached session with a free name. Like `t`, it starts in the
    current directory; with preset, like `t -p`, it gets the preset layout,
    at the size it has when it shows here. Returns (name, error): the error
    can come with a name, when only the preset failed."""
    taken = (tmux("list-sessions", "-F", "#{session_name}") or "").splitlines()
    name = session_name(taken)
    size = []
    if preset:  # made at the size it gets here, so that switching to it resizes nothing
        w, h = window_size()
        size = ["-x", str(w), "-y", str(h)]
    if tmux("new-session", "-d", "-s", name, *size) is None:
        return None, "couldn't create tmux session " + name
    return name, apply_preset("=%s:" % name) if preset else None


def find(prefix):
    hits = [r for r in records() if r["session_id"].startswith(prefix)]
    return hits[0] if len(hits) == 1 else None


def one_shot(vertical=False):
    snap = snapshot()
    rows, _ = build_rows(snap)
    color = sys.stdout.isatty()
    size = shutil.get_terminal_size((160, 24))
    # Vertical summaries fit a terminal, or LINES, with a line left for the
    # shell's prompt; a pipe gets them whole.
    height = size.lines - 3 if color or os.environ.get("LINES") else 0
    lines, _ = body_lines(rows, size.columns, color, vertical=vertical, height=height)
    print("\n".join([title(snap, "tls", color, size.columns), ""] + lines))
    return 0


HINT = "↑↓ select · enter or 1-9 open/resume · n new session · del delete · R resume all dead · q quit · * attached"
HINT_V = "↑↓ enter n del R q"  # the vertical layout's, for a narrow window
DEL = ("\x7f", "\x08", "\033[3~")  # Backspace (the Mac delete key), ^H, forward Delete
NAV = {"\033[A": "up", "\033OA": "up", "\033[B": "down", "\033OB": "down",
       "\033[5~": "pgup", "\033[6~": "pgdn",
       "\033[H": "home", "\033OH": "home", "\033[1~": "home", "\033[7~": "home",
       "\033[F": "end", "\033OF": "end", "\033[4~": "end", "\033[8~": "end"}
ENTER = ("\r", "\n")


def read_keys(fd):
    """The keys waiting on fd, escape sequences (arrows, Home, ...) whole even
    when split across reads; a lone ESC is the Esc key. None: input is gone."""
    import select
    try:
        buf = os.read(fd, 1024)
        while re.search(rb"\033(\[[0-9;]*|O)?$", buf) and select.select([fd], [], [], 0.05)[0]:
            more = os.read(fd, 1024)
            if not more:
                break
            buf += more
    except OSError:
        return None
    if not buf:
        return None
    return re.findall(r"\033\[[0-9;?]*[ -/]*[@-~]|\033O.|\033.?|.", buf.decode(errors="ignore"), re.S)


def wrap(text, width, most=None, hang=""):
    """text as lines of at most width columns, at most `most` of them (None:
    no limit); the lines after the first start with hang."""
    import textwrap
    width = max(1, width)
    hang = hang if len(hang) < width else ""
    lines = [fit(l, width) for l in textwrap.wrap(text, width, subsequent_indent=hang)] or [""]
    if most and len(lines) > most:  # not textwrap's max_lines: a long word left it a line of just "…"
        lines = lines[:most]
        lines[-1] = fit(lines[-1] + "…", width)
    return lines


def auto_vertical(size, cell):
    """ttop with neither -v nor -h: vertical in a window of size (columns,
    lines) under [ttop] narrow columns, or taller than wide in pixels, such as
    a bar on the right; cell is a cell's size in pixels."""
    cols, lines = size
    return cols < conf("ttop", "narrow") or lines * cell[1] > cols * cell[0]


def fit_size(rows, vertical, size, win, cell):
    """ttop -f: the size (columns, lines) of a pane that shows rows with no
    space left over; the other side stays as it is. Vertical: as wide as its
    lines with nothing cut, within [ttop] fit-min-width and fit-max-width, and
    a third of the window win at most.
    Horizontal: as high as the list and its title, 2 lines to a third of the
    window, and not taller than wide in pixels, so that it stays horizontal."""
    cols, lines = size
    if vertical:  # + 1: ttop stays off the last column
        return max(conf("ttop", "fit-min-width"),
                   min(natural_width(rows) + 1, conf("ttop", "fit-max-width"), win[0] // 3)), lines
    body = sum(2 if "section" in r else 1 for r in rows) or 1  # as many lines as body_lines draws
    want = 1 + body if 1 + body < conf("ttop", "short") else 4 + body  # a bar has only its title line besides
    return cols, max(2, min(want, win[1] // 3, cols * cell[0] // cell[1]))


def ttop(vertical=None, preset=False, fit_pane=False):
    """vertical: True, False, or None to pick by the window's shape on each
    frame; preset: n makes new sessions in the preset layout; fit_pane: -f,
    size this tmux pane to the list (not fit, which is the text cutter)."""
    import select
    import signal
    import termios
    import tty
    fd, out = sys.stdin.fileno(), sys.stdout
    saved = termios.tcgetattr(fd)
    wake, wake_w = os.pipe()  # a resize (SIGWINCH) writes to it, which wakes the select below
    for f in (wake, wake_w):
        os.set_blocking(f, False)
    here = os.environ.get("TMUX_PANE") if inside_tmux() else None  # the pane that -f resizes
    cell = cell_size() if here else (1, 2)
    if here:
        register_tmux_hooks()  # a bar keeps its size when the window changes size
    fitted, fit_at = None, 0  # (size wanted, size then): -f asks tmux once for each, once a second at most
                              # (two fitted ttops in one row could take the room from each other forever)

    def enter():
        tty.setcbreak(fd)
        out.write("\033[?1049h\033[?25l")
        out.flush()

    def leave():
        termios.tcsetattr(fd, termios.TCSADRAIN, saved)
        out.write("\033[?25h\033[?1049l")
        out.flush()

    signal.set_wakeup_fd(wake_w)
    signal.signal(signal.SIGWINCH, lambda *_: None)
    enter()
    sel = sel_id = None  # selected row, and its id to find it again after a refresh
    top = refresh_at = msg_until = 0
    msg, ask = "", None  # ask: (until, on Enter, on a dead agent's key) while a question is up
    if conf_problems():
        msg, msg_until = "tls.conf: %s · tls config" % conf_problems()[0], time.time() + 10
    try:
        while True:
            if time.time() >= refresh_at:
                snap = snapshot()
                rows, hotkeys = build_rows(snap, live=True)
                picks = [i for i, r in enumerate(rows) if r.get("action")]
                refresh_at = time.time() + 1
                if picks:  # the same agent if it's still listed, else the nearest row
                    near = sel or 0
                    sel = next((i for i in picks if rows[i]["id"] == sel_id),
                               min(picks, key=lambda i: (abs(i - near), i)))
                    sel_id = rows[sel]["id"]
                else:
                    sel = None
            size = tuple(shutil.get_terminal_size((100, 30)))
            vert = auto_vertical(size, cell) if vertical is None else vertical
            if fit_pane and here:
                win = next(((int(p["width"]), int(p["height"])) for p in snap["panes"] if p["pane"] == here), None)
                want = fit_size(rows, vert, size, win, cell) if win else size
                if want != size and (want, size) != fitted and time.time() >= fit_at:
                    fitted, fit_at = (want, size), time.time() + 1  # tmux applies it a moment later: SIGWINCH redraws
                    tmux("resize-pane", "-t", here, *(("-x", str(want[0])) if vert else ("-y", str(want[1]))))
            cols, lines = size
            width = cols - 1  # stay off the last column: no autowrap
            text = msg if time.time() < msg_until else ""
            if lines < conf("ttop", "short"):  # a bar, such as a preset's: no blank lines, the hint on the title line
                head = [title(snap, "ttop", True, width, (HINT_V,) if vert else (HINT, HINT_V))]
                foot = [dim(l, True) for l in wrap(text, width, 2)] if text else []
            else:
                head = [title(snap, "ttop", True, width), ""]
                text = text or (HINT_V if vert else HINT)
                foot = [""] + [dim(l, True) for l in (wrap(text, width, 4) if vert else [fit(text, width)])]
            room = max(1, lines - len(head) - len(foot))
            body, at = body_lines(rows, width, True, live=True, sel=sel, vertical=vert, height=room)
            if sel is not None:  # scroll the selection, all its lines, into view
                y0, y1 = at[sel]
                row_ys = {y for a, b in at.values() for y in range(a, b + 1)}
                if y0 < top:
                    top = y0
                    while top > 0 and top - 1 not in row_ys and y1 - top + 1 < room:
                        top -= 1  # bring its section heading along
                top = min(max(top, y1 - room + 1), y0)
            top = max(0, min(top, len(body) - room))
            screen = (head + body[top:top + room] + foot)[:lines]
            out.write("\033[H" + "\n".join(l + "\033[K\033[0m" for l in screen) + "\033[J")
            out.flush()
            ready = select.select([fd, wake], [], [], max(0, refresh_at - time.time()))[0]
            if wake in ready:  # a resize: draw again at the new size
                try:
                    os.read(wake, 512)
                except OSError:
                    pass
            if fd not in ready:
                continue
            keys = read_keys(fd)
            if keys is None:
                return 0
            for k in keys:
                pending, ask = (ask if ask and time.time() < ask[0] else None), None
                if pending:  # any key answers the question
                    i = hotkeys.get(k)
                    if k in ENTER and pending[1]:
                        msg = pending[1]()
                    elif pending[2] and i is not None and rows[i]["kind"] in DEAD:
                        msg = pending[2](i)
                    else:
                        msg = "cancelled"
                    msg_until, refresh_at = time.time() + 4, 0
                    continue
                if k == "q":
                    return 0
                if k in NAV:
                    if picks:
                        page = max(1, (room - 1) // (3 if vert else 1))  # in rows; vertical: ~3 lines each
                        step = {"up": -1, "down": 1, "pgup": -page, "pgdn": page,
                                "home": -len(picks), "end": len(picks)}[NAV[k]]
                        j = picks.index(sel) + step if sel in picks else 0
                        sel = picks[max(0, min(len(picks) - 1, j))]
                        sel_id = rows[sel]["id"]
                    continue
                if k in DEL or k == "d" and sel is not None and rows[sel]["kind"] in DEAD:
                    if sel is not None:
                        msg, action = delete_ask(rows[sel], snap)
                        msg_until = time.time() + 10
                        ask = (msg_until, action, None) if action else None
                    continue
                if k == "d":
                    msg, msg_until = "forget which dead agent? press its key · esc: cancel", time.time() + 10
                    ask = (msg_until, None, lambda i: forget(rows[i]["recs"], rows[i]["name"]))
                    continue
                if k == "R":
                    names = restore_all(snap)
                    msg = "resumed " + ", ".join(names) if names else "nothing to resume"
                    msg_until, refresh_at = time.time() + 5, 0
                    continue
                if k == "n":
                    name, err = new_session(preset)
                    if name:
                        sel_id = ("session", name)  # the refresh selects its row
                        err = open_session(name, None, None, leave, enter) or err
                    if err:
                        msg, msg_until = err, time.time() + 5
                    refresh_at = 0
                    break  # the list changed under any keys typed after this one
                i = sel if k in ENTER else hotkeys.get(k)
                if i is None or not rows[i].get("action"):
                    continue
                sel, sel_id, act = i, rows[i]["id"], rows[i]["action"]
                if act[0] == "seen":  # outside tmux: nothing to switch to
                    if act[1].get("state") == "done":
                        mark_seen(act[1])
                        refresh_at = 0
                    else:
                        msg, msg_until = rows[i]["name"] + " isn't in tmux: nothing to switch to", time.time() + 4
                    continue
                if act[0] == "noresume":  # its agent never said how to resume it
                    msg = "%s left no resume command: del forgets it" % (rows[i]["name"] or rows[i]["label"])
                    msg_until = time.time() + 5
                    continue
                if act[0] == "open":
                    err = open_session(*act[1:], leave=leave, enter=enter)
                else:  # restore
                    name, pane = restore(act[1])
                    err = open_session(name, pane, None, leave, enter) if name else pane
                if err:
                    msg, msg_until = err, time.time() + 5
                refresh_at = 0
                break  # the list changed under any keys typed after this one
    except KeyboardInterrupt:
        return 0
    finally:
        leave()
        signal.signal(signal.SIGWINCH, signal.SIG_DFL)
        signal.set_wakeup_fd(-1)
        os.close(wake)
        os.close(wake_w)


def main(argv):
    cmd = argv[0] if argv else ""
    if cmd == "hook" and argv[1:] in ([], ["claude"]):  # the Claude Code adapter
        guarded(hook)
        return 0
    if cmd == "report":
        try:
            return report_cmd(argv[1:])
        except (ValueError, OSError) as e:
            print("tls report: %s" % e, file=sys.stderr)
            return 2
    if cmd == "seen" and len(argv) == 2:
        guarded(seen, argv[1])
        return 0
    if cmd == "relayout" and len(argv) == 2:  # tmux hook, after a window changed size
        guarded(relayout, argv[1])
        return 0
    if cmd == "setup":
        return setup()
    if cmd == "resume" and len(argv) == 2:
        snap = snapshot()
        if argv[1] == "all":
            names = restore_all(snap)
            print("resumed: %s" % (", ".join(names) or "nothing"))
            return 0
        rec = find(argv[1])
        group = [recs for _, recs in dead_groups(snap)
                 if rec and rec["session_id"] in {r["session_id"] for r in recs}]
        if not group:
            print("no dead agent matches %s" % argv[1], file=sys.stderr)
            return 1
        name, pane = restore(ready(group[0]))
        print("resumed in %s (%s)" % (name, pane) if name else pane)
        return 0 if name else 1
    if cmd == "forget" and len(argv) == 2:
        rec = find(argv[1])
        if not rec:
            print("no agent matches %s" % argv[1], file=sys.stderr)
            return 1
        remove(rec["session_id"])
        return 0
    if cmd == "new-name":
        print(session_name((tmux("list-sessions", "-F", "#{session_name}") or "").splitlines()))
        return 0
    if cmd == "top":  # ttop [-v | -h] [-p] [-f]: here -h is horizontal, and --help the help
        flags = {"-v": ("vertical", True), "--vertical": ("vertical", True), "-h": ("vertical", False),
                 "--horizontal": ("vertical", False), "-p": ("preset", True), "--preset": ("preset", True),
                 "-f": ("fit_pane", True), "--fit": ("fit_pane", True)}
        opts = {"vertical": {"auto": None, "vertical": True, "horizontal": False}[conf("ttop", "layout")],
                "preset": False, "fit_pane": False}  # vertical None: by the window's shape
        for a in argv[1:]:
            if a not in flags:
                print(__doc__.strip())
                return 0 if a == "--help" else 2
            opts[flags[a][0]] = flags[a][1]
        if sys.stdin.isatty() and sys.stdout.isatty():
            return ttop(**opts)
        return one_shot(bool(opts["vertical"]))
    if cmd == "config" and argv[1:] in ([], ["--defaults"]):
        sys.stdout.write(config_text(defaults=argv[1:] == ["--defaults"]))
        return 0
    if cmd == "bar" and len(argv) in (2, 3) and argv[1] in ("right", "bottom"):  # ttv, tth [WINDOW]
        name = "ttv" if argv[1] == "right" else "tth"
        target = argv[2] if len(argv) == 3 else os.environ.get("TMUX_PANE", "")
        if target.startswith("-"):
            print(__doc__.strip())
            return 0 if target in ("-h", "--help") else 2
        err = add_bar(target, argv[1]) if target else "not in tmux: run %s in a tmux pane, or name a window" % name
        if err:
            print("%s: %s" % (name, err), file=sys.stderr)
        return 1 if err else 0
    if cmd == "preset" and len(argv) <= 2:
        err = apply_preset(argv[1] if len(argv) == 2 else os.environ.get("TMUX_PANE", ""))
        if err:
            print("tls preset: " + err, file=sys.stderr)
        return 1 if err else 0
    if argv in (["-v"], ["--vertical"]):
        return one_shot(vertical=True)
    if cmd not in ("", "-1", "--horizontal"):  # -1: what plain tls did before ttop existed
        print(__doc__.strip())
        return 0 if cmd in ("-h", "--help") else 2
    return one_shot()


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
