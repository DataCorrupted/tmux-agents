$T kill-session -t =cf
printf '[ttv]\nwidth = wide\nwide-width = 34  # a comment\ncolour = red\n[preset]\nlayout = right\n' > "$TLS_CONFIG"
TLS_PRESET=bottom "$TLS" config > "$D/config.out"
check "tls config shows the value of each setting, where it comes from, and the lines that tls ignores" \
