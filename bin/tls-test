check "an environment variable wins over tls.conf" 'grep -qx "layout = bottom  # from TLS_PRESET" "$D/config.out"'
printf '[ttop]\nlayout = vertical\n' > "$TLS_CONFIG"
CV=$($TT new-session -d -P -F '#{pane_id}' -s confv -x 160 -y 20 \
  "env -u TMUX TLS_STATE_DIR='$D/state' TLS_TMUX='-L $SRV' '$HERE/ttop'")
check "layout = vertical in tls.conf: plain ttop is vertical in a window where auto is horizontal" 'retry hint_v "$CV"'
$TT kill-session -t confv
rm -f "$TLS_CONFIG"

# Bold marks where you are: in a ttop inside tmux, the name of its session,
# and of the agent whose pane is active there, or was, when you go into ttop.
$T new-session -d -s fo-here -x 200 -y 30 "sleep 600"
FA=$($T display -p -t =fo-here: '#{pane_id}')
FB=$($T split-window -d -h -P -F '#{pane_id}' -t "$FA" "sleep 600")
FT=$($T split-window -d -h -P -F '#{pane_id}' -t "$FB" "env TLS_STATE_DIR='$D/state' '$HERE/ttop' -h")
sleep 600 & FAKE10=$!
TMUX="$SOCK,1,0" TMUX_PANE="$FA" "$TLS" report id=focus-a agent=codex pid=$FAKE10 state=idle name=agent-a
TMUX="$SOCK,1,0" TMUX_PANE="$FB" "$TLS" report id=focus-b agent=codex pid=$FAKE10 state=idle name=agent-b
bold_in() { $T capture-pane -ep -t "$FT" | grep -aqE $'\e''\[1m('$'\e''\[[0-9;]*m)*'"$1"; }   # bold_in TEXT: ttop shows TEXT in bold
only_bold() { bold_in "$1" && ! bold_in "$2"; }
check "ttop shows in bold the session it is in, and the agent whose pane is active" 'retry only_bold agent-a agent-b && bold_in fo-here'
$T select-pane -t "$FB"
check "the bold goes with the active pane" 'retry only_bold agent-b agent-a'
$T select-pane -t "$FT"; sleep 2   # 2 refreshes: the screen from before can pass too
check "in ttop itself, the pane you came from stays bold" 'only_bold agent-b agent-a'
"$TLS" forget focus-a; "$TLS" forget focus-b; kill "$FAKE10"; $T kill-session -t =fo-here
bold_py() {  # bold names in the vertical lines and the horizontal line of a row where you are: "sessions agents"
  /usr/bin/python3 -ISB -c 'import importlib.machinery as m, importlib.util as u, sys
l = m.SourceFileLoader("tls", sys.argv[1]); t = u.module_from_spec(u.spec_from_loader("tls", l)); l.exec_module(t)
r = dict(t.BLANK, kind="session", name="sess-x", key="1", state="idle", label="agent-x", here=True, here_pane=True)
text = "\n".join(t.row_lines_v(r, (4, 7, True), 30, True, True) + [t.row_line(r, (8, 4, 7), 80, True, True)])
print(text.count("\033[1msess-x"), text.count("\033[1magent-x"))' "$TLS"
}
check "the vertical and the horizontal layout both draw the names of where you are in bold" '[ "$(bold_py)" = "2 2" ]'
parts_py() {  # a session with one agent: two rows, one line in the horizontal layout; "ok" or what went wrong
  /usr/bin/python3 -ISB -c 'import importlib.machinery as m, importlib.util as u, sys, re
l = m.SourceFileLoader("tls", sys.argv[1]); t = u.module_from_spec(u.spec_from_loader("tls", l)); l.exec_module(t)
snap = {"sessions": [{"name": "empty", "attached": False, "agents": []},
                     {"name": "solo", "attached": False, "agents": [{"pane": "%9", "window": "0", "index": "0",
                      "rec": {"state": "done", "agent": "claude"}}]}], "outside": [], "gone": [], "panes": []}
rows, keys = t.build_rows(snap, live=True)
def lines(sel, vertical):  # the bar as [ and its end as ], no other colors
    out = t.body_lines(rows, 60, True, live=True, sel=sel, vertical=vertical)[0]
    return [re.sub("\033\\[[0-9;]*m", "", s.replace(t.BAR, "[").replace("\033[49m", "]")).rstrip() for s in out]
h1, h2, v1, v2 = lines(1, False), lines(2, False), lines(1, True), lines(2, True)
want = {"rows": [r["kind"] for r in rows] == ["session", "session", "agent"], "keys": keys == {"1": 0, "2": 2},
        "h: two lines": len(h1) == len(h2) == 2, "h: bar under the name": re.match(r"\[▌2 solo *\] ●", h1[1]),
        "h: bar from the agent": re.match(r" 2 solo *\[▌● done", h2[1]),
        "h: none on the line before": h1[0] == h2[0] == " 1 empty",
        "v: bar under the name line": v1[1].startswith("[▌2 solo") and not v1[2].startswith("["),
        "v: bar under the agent line": not v2[1].startswith("[") and v2[2].startswith("[▌ ● done"),
        "fit: two lines": t.fit_size(rows, False, (60, 20), (60, 60), (1, 2))[1] == 3}
bad = [k for k, v in want.items() if not v]
print("ok" if not bad else "%s: %r" % (bad, (h1, h2, v1, v2)))' "$TLS"
}
check "a session with one agent: two rows to select, on one line in the horizontal layout" '[ "$(parts_py)" = ok ]'
check "no hook errors logged" '[ ! -s "$D/state/errors.log" ]'

# tls setup in a fake $HOME: merges the hooks without disturbing others,
# comments out the old alias, and a rerun changes nothing.
H="$D/home"; mkdir -p "$H/.claude"
cat > "$H/.claude/settings.json" <<'JSON'
{
  "hooks": {
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/opt/other/hook.sh",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "verbose": true
}
JSON
printf '%s\n' 'export A=1' "alias tls='tmux list-sessions'" > "$H/.bashrc"
setup() { HOME="$H" TLS_TMUX="-L $SRV" "$TLS" setup; }
settings_ok() {
  /usr/bin/python3 -IS - "$H/.claude/settings.json" "$TLS hook" <<'PY'
import json, sys
c = json.load(open(sys.argv[1]))
h = c["hooks"]
mine = {ev: [x for g in gs for x in g["hooks"] if x["command"] == sys.argv[2]] for ev, gs in h.items()}
assert sorted(ev for ev, m in mine.items() if len(m) == 1) == sorted(
    "PermissionRequest SessionStart UserPromptSubmit PostToolUse Notification Stop StopFailure SessionEnd PreToolUse".split()), mine
assert h["PermissionRequest"][0]["hooks"][0]["command"] == "/opt/other/hook.sh"
assert h["PreToolUse"][-1]["matcher"] == "AskUserQuestion|ExitPlanMode"
assert c["verbose"] is True
PY
}
out=$(setup)
check "setup merges the Claude hooks, keeps the others" 'settings_ok'
check "setup backs up settings.json" '[ "$(ls "$H/.claude" | grep -c "^settings.json.bak-tls-")" = 1 ]'
check "setup comments out the alias" 'grep -q "^# tls is .*Was: alias tls='"'"'tmux list-sessions'"'"'$" "$H/.bashrc" && ! grep -q "^alias tls=" "$H/.bashrc"'
check "setup registers the tmux hooks" 'echo "$out" | grep -q "registered on the running tmux server"'
cp "$H/.claude/settings.json" "$D/settings.before"; cp "$H/.bashrc" "$D/bashrc.before"
out=$(setup)
check "setup again changes nothing" 'cmp -s "$H/.claude/settings.json" "$D/settings.before" && cmp -s "$H/.bashrc" "$D/bashrc.before" && [ "$(ls "$H/.claude" | grep -c "^settings.json.bak-tls-")" = 1 ] && echo "$out" | grep -q "already in"'
echo '{"hooks": ' > "$H/.claude/settings.json"
out=$(setup)
check "setup leaves broken JSON alone" 'echo "$out" | grep -q "left alone" && [ "$(cat "$H/.claude/settings.json")" = "{\"hooks\": " ]'

echo
[ "$fails" -eq 0 ] && echo "all passed" || echo "$fails failed"
exit "$fails"
