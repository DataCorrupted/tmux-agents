#!/bin/bash
# Self-test for tls and tmux-agents.bash: fake Claude hook payloads and agent
# reports against throwaway tmux servers (every tmux command names its socket),
# a temp state dir and a fake $HOME. Never touches your tmux server, your
# settings or ~/.local/state/agent-tls.
#   tls-test
set -u
HERE=$(cd "$(dirname "$(readlink -f "$0")")" && pwd)
TLS="$HERE/tls"
D=$(mktemp -d /tmp/tls-test.XXXXXX)
SRV="tls_test_$$"
T="tmux -L $SRV"
TT="tmux -L ${SRV}_term"   # stands in for your terminal: its panes are real ttys
fails=0
check() { if eval "$2"; then echo "PASS $1"; else echo "FAIL $1"; fails=$((fails + 1)); fi; }
retry() { for _ in $(seq 25); do "$@" && return 0; sleep 0.2; done; return 1; }
field() { /usr/bin/python3 -IS -c "import json,sys; r=json.load(open(sys.argv[1])); print(r$1)" "$D/state/$SID.json" 2>/dev/null; }
cleanup() {
  $T kill-server 2>/dev/null; $TT kill-server 2>/dev/null
  kill "$FAKE" ${FAKE2:-} ${FAKE3:-} ${FAKE5:-} ${FAKE6:-} ${FAKE7:-} ${FAKE8:-} ${FAKE9:-} ${FAKE10:-} 2>/dev/null
  rm -f "${TMUX_TMPDIR:-/tmp}/tmux-$(id -u)/$SRV" "${TMUX_TMPDIR:-/tmp}/tmux-$(id -u)/${SRV}_term"
  rm -rf "$D"
}
trap cleanup EXIT

export TLS_STATE_DIR="$D/state"   # tls has to create it
export TLS_CONFIG="$D/tls.conf"   # not yours: no file, so every setting is at its default
touch "$D/transcript.jsonl"
SID=11111111-2222-3333-4444-555555555555

# Throwaway server: session "alpha" whose pane stands in for an agent; new
# windows run `cat` so resume's keystrokes land somewhere harmless.
$T -f /dev/null new-session -d -s alpha -x 160 -y 40 "sleep 600"
$T set -g default-command "cat"
PANE=$($T display -p -t alpha '#{pane_id}')
SOCK=$($T display -p '#{socket_path}')
sleep 600 & FAKE=$!   # stands in for the claude process (liveness)

hook() {  # hook EVENT [extra JSON fields]
  printf '{"session_id":"%s","hook_event_name":"%s","cwd":"%s","transcript_path":"%s"%s}' \
    "$SID" "$1" "$D" "$D/transcript.jsonl" "${2:+,$2}" |
    TMUX="$SOCK,1,0" TMUX_PANE="$PANE" CLAUDE_PID="$FAKE" CLAUDE_CODE_ENTRYPOINT=cli "$TLS" hook
}
pane_opt() { $T show -pqv -t "$PANE" "$1"; }
view() { TLS_TMUX="-L $SRV" "$TLS"; }

out=$(hook SessionStart '"source":"startup"')
check "hook prints nothing" '[ -z "$out" ]'
check "start -> idle" '[ "$(field "[\"state\"]")" = idle ]'
check "pane option mirrored" '[ "$(pane_opt @agent-state)" = idle ] && [ "$(pane_opt @agent-session)" = "$SID" ]'
check "tmux session recorded" '[ "$(field "[\"tmux\"][\"session\"]")" = alpha ]'
check "seen hooks registered on the agent's tmux server" \
  '[ "$($T show-hooks -g | grep -cF "$TLS seen")" = 4 ] && $T show-hooks -gw | grep -F "pane-focus-in[42]" | grep -qF "$TLS seen"'

hook UserPromptSubmit '"prompt":"rebase the stack\nsecond line"'
check "prompt -> working" '[ "$(field "[\"state\"]")" = working ]'
check "prompt first line kept" '[ "$(field "[\"prompt\"]")" = "rebase the stack" ]'
hook UserPromptSubmit '"prompt":"<task-notification>\n<task-id>x</task-id>"'
check "task notification doesn't replace prompt" '[ "$(field "[\"prompt\"]")" = "rebase the stack" ]'

hook PreToolUse '"tool_name":"AskUserQuestion","tool_input":{"questions":[{"question":"Red or blue?"}]}'
check "AskUserQuestion -> waiting + question" '[ "$(field "[\"state\"]")" = waiting ] && [ "$(field "[\"reason\"]")" = "Red or blue?" ]'
hook PostToolUse '"tool_name":"AskUserQuestion"'
check "answer -> working" '[ "$(field "[\"state\"]")" = working ]'

hook PermissionRequest '"tool_name":"Bash","tool_input":{"command":"rm -rf build"}'
check "permission -> waiting" '[ "$(field "[\"state\"]")" = waiting ] && [ "$(field "[\"reason\"]")" = "permission: Bash rm -rf build" ]'
hook PostToolUse '"tool_name":"Bash"'

hook Stop '"last_assistant_message":"Fixed it.\n\nShould I land it?","background_tasks":[]'
check "question at end -> waiting" '[ "$(field "[\"state\"]")" = waiting ]'
hook UserPromptSubmit '"prompt":"yes"'
hook Stop '"last_assistant_message":"Please tap your YubiKey so I can continue.","background_tasks":[]'
check "yubikey -> blocked" '[ "$(field "[\"state\"]")" = blocked ]'
check "classifier leaves no __pycache__ next to tls" '[ ! -e "$HERE/__pycache__" ]'
hook UserPromptSubmit '"prompt":"build it"'
hook Stop '"last_assistant_message":"Build started.","background_tasks":[{"id":"b1","type":"shell","status":"running","description":"make release build"}]'
check "running background task -> bg" '[ "$(field "[\"state\"]")" = bg ] && [ "$(field "[\"reason\"]")" = "background: make release build" ]'
hook UserPromptSubmit '"prompt":"<task-notification>done</task-notification>"'
hook Stop '"last_assistant_message":"Build passed. Want me to also run the tests?","background_tasks":[]'
check "optional offer -> done" '[ "$(field "[\"state\"]")" = done ]'

hook StopFailure '"error":"rate_limit"'
check "failure after the turn ignored" '[ "$(field "[\"state\"]")" = done ]'

# Looking at a green agent turns it grey (the hooks registered above).
$T split-window -d -t alpha "sleep 600"   # selecting the already-active pane fires no hook
$T select-pane -t alpha:0.1 ; $T select-pane -t "$PANE"
for _ in $(seq 20); do [ "$(field "[\"state\"]")" = idle ] && break; sleep 0.2; done
check "after-select-pane marks done as seen" '[ "$(field "[\"state\"]")" = idle ] && [ "$(pane_opt @agent-state)" = idle ]'

hook UserPromptSubmit '"prompt":"next"'
hook Stop '"last_assistant_message":"All done.","background_tasks":[]'
check "view shows the session and green state" 'view | grep -q "alpha .*done .*All done."'
$T new-window -d -t alpha:
$T select-window -t alpha:1 ; $T select-window -t alpha:0
for _ in $(seq 20); do [ "$(field "[\"state\"]")" = idle ] && break; sleep 0.2; done
check "session-window-changed marks done as seen" '[ "$(field "[\"state\"]")" = idle ]'

out=$(printf '{"session_id":"99999999-0000-0000-0000-000000000000","hook_event_name":"SessionStart","source":"startup"}' |
  TMUX="$SOCK,1,0" TMUX_PANE="$PANE" CLAUDE_PID="$FAKE" CLAUDE_CODE_ENTRYPOINT=sdk-cli "$TLS" hook)
check "headless claude -p ignored" '[ ! -e "$D/state/99999999-0000-0000-0000-000000000000.json" ]'

# Without CLAUDE_PID, the hook takes the nearest process above it named claude.
# Claude Code runs a hook through a shell, so the hook's parent is not claude.
SID8=88888888-0000-0000-0000-000000000000
cat > "$D/as-claude" <<EOF
sh -c 'printf %s "\$1" | env -u CLAUDE_PID -u TMUX -u TMUX_PANE CLAUDE_CODE_ENTRYPOINT=cli "\$0" hook' "$TLS" \
  '{"session_id":"$SID8","hook_event_name":"SessionStart","source":"startup","cwd":"$D","transcript_path":"$D/transcript.jsonl"}'
echo \$\$
EOF
CPID=$(bash -c "exec -a claude bash '$D/as-claude'")
check "without CLAUDE_PID, the hook finds the claude process it runs under" '[ "$(SID=$SID8 field "[\"pid\"]")" = "$CPID" ]'
"$TLS" forget $SID8

# Agent dies without SessionEnd (crash / reboot): shown as dead, resumable.
kill "$FAKE"; wait "$FAKE" 2>/dev/null
check "dead agent listed" 'view | grep -q "dead" && view | grep -q "alpha .*was idle"'
TLS_TMUX="-L $SRV" "$TLS" resume "${SID:0:8}" >/dev/null
sleep 0.5
check "resume types claude --resume in a new window" '$T capture-pane -p -t alpha:2 | grep -q "claude --resume $SID"'
check "row shows resuming" 'view | grep -q "resuming"'

# SessionEnd: killed keeps the record, deliberate exit removes it.
sleep 600 & FAKE=$!
hook SessionStart '"source":"resume"'
check "resume makes it live again" 'view | grep -q "alpha .*idle" && ! view | grep -q dead'
hook SessionEnd '"reason":"other"'
check "killed (reason other) stays resumable" '[ "$(field "[\"ended\"][\"reason\"]")" = other ] && view | grep -q "was idle"'
check "pane option cleared on end" '[ -z "$(pane_opt @agent-state)" ]'
hook SessionStart '"source":"resume"'
hook SessionEnd '"reason":"prompt_input_exit"'
check "deliberate exit removes record" '[ ! -e "$D/state/$SID.json" ]'

# tls and ttop on a real terminal. Sessions now: alpha (no agent) and beta,
# whose agent has just finished (green).
$TT -f /dev/null new-session -d -s term -x 160 -y 40 "sleep 600"
$TT set -g remain-on-exit on
$T new-session -d -s beta -x 160 -y 40 "sleep 600"
SID2=22222222-3333-4444-5555-666666666666
PANE2=$($T display -p -t beta '#{pane_id}')
sleep 600 & FAKE2=$!
beta() { SID=$SID2 PANE=$PANE2 FAKE=$FAKE2 hook "$@"; }
beta SessionStart '"source":"startup"'
beta UserPromptSubmit '"prompt":"bisect it"'
beta Stop '"last_assistant_message":"All done.","background_tasks":[]'
state_is() { [ "$(SID=$1 field "[\"state\"]")" = "$2" ]; }   # state_is SID STATE
term() { $TT new-window -d -P -F '#{pane_id}' -t term: "env -u TMUX TLS_STATE_DIR='$D/state' TLS_TMUX='-L $SRV' $1"; }
shows() { $TT capture-pane -p -t "$1" | grep -q "$2"; }      # shows PANE PATTERN, on the terminal
shows_in() { $T capture-pane -p -t "$1" | grep -q "$2"; }    # same, inside the test server
exited_ok() { [ "$($TT display -p -t "$1" '#{pane_dead}#{pane_dead_status}')" = 10 ]; }
client_on() { $T list-clients -F '#{client_session}' | grep -qx "$1"; }

P=$(term "'$TLS'")
check "tls on a terminal prints once and exits" 'retry exited_ok "$P" && shows "$P" "beta .*done .*All done."'

# Outside tmux: Enter attaches here, and detaching comes back to ttop.
P=$(term "'$HERE/ttop'")
check "ttop starts on the first session, highlighted" \
  'retry shows "$P" "▌1 *alpha" && $TT capture-pane -ep -t "$P" | grep "alpha" | grep -q "48;5;237"'
$TT send-keys -t "$P" Down
check "down arrow moves the highlight" 'retry shows "$P" "▌2.*beta .*done" && ! shows "$P" "▌1"'
# beta and its only agent share a line, but are two rows to select.
$TT send-keys -t "$P" Down
check "down again selects beta's agent: the mark moves to the agent's dot" \
  'retry shows "$P" "^ 2 beta *▌● done"'
$TT send-keys -t "$P" Up Up
check "up arrow moves it back" 'retry shows "$P" "▌1 *alpha"'
sel_line() { $TT capture-pane -p -t "$P" | grep "▌" | cut -c1-20; }   # the selected row's key and name
$TT send-keys -t "$P" End
retry eval '! shows "$P" "▌1"'
LAST=$(sel_line)
$TT send-keys -t "$P" Home
retry shows "$P" "▌1 *alpha"
$TT send-keys -t "$P" Up
same_sel() { [ "$(sel_line)" = "$LAST" ]; }
check "up on the first row goes round to the last row" 'retry same_sel'
$TT send-keys -t "$P" Down
check "and down on the last row goes round to the first" 'retry shows "$P" "▌1 *alpha"'
$TT send-keys -t "$P" Down Down Enter
check "enter attaches to the selected session" 'retry client_on beta'
check "opening a green agent marks it seen" 'retry state_is $SID2 idle'
$T detach-client -s beta
check "detaching comes back to ttop, same row selected" 'retry shows "$P" "^ 2 beta *▌○ idle"'
# n creates a session named like `t` names one, in ttop's directory, and opens it.
new_client() { $T list-clients -F '#{client_session}' | grep -Ex '[a-z]+-[a-z]+' | head -1 | grep .; }
$TT send-keys -t "$P" n
check "n attaches to a new adjective-noun session" 'retry new_client >/dev/null'
NEW=$(new_client)
check "the new session starts in ttop's directory" '[ -n "$NEW" ] && [ "$($T display -p -t "=$NEW:" "#{pane_current_path}")" = "$(pwd -P)" ]'
$T detach-client -s "$NEW"
check "detaching comes back to ttop, new session selected" '[ -n "$NEW" ] && retry shows "$P" "▌.*$NEW"'
$T kill-session -t "=$NEW"   # the checks below count on alpha and beta only
$TT send-keys -t "$P" q
check "q quits ttop" 'retry exited_ok "$P"'

# Inside tmux: ttop runs in alpha while a client is attached to alpha; a key
# or Enter has to switch that client.
$TT new-window -d -t term: "env -u TMUX tmux -L $SRV attach -t alpha"
retry client_on alpha
TP=$($T new-window -P -F '#{pane_id}' -t alpha: "TLS_STATE_DIR='$D/state' '$HERE/ttop'")
retry shows_in "$TP" "▌1 *alpha"
# beta gets a ttop bar, as from ttv; its ttop starts on the first row.
BAR=$($T split-window -d -h -l 25 -P -F '#{pane_id}' -t "$PANE2" "'$HERE/ttop' -v")
retry shows_in "$BAR" "▌1 *alpha"
switch_to() { $T switch-client -c "$($T list-clients -F '#{client_name}')" -t "$1"; }
active_is() { [ "$($T display -p -t "=$1:" '#{pane_id}')" = "$2" ]; }   # active_is SESSION PANE
$T send-keys -t "$TP" 2
check "a session's key switches the attached client" 'retry client_on beta'
check "to the session's most urgent agent, not to its ttop bar" 'active_is beta "$PANE2"'
switch_to alpha
check "client back on alpha" 'client_on alpha'
$T send-keys -t "$TP" Home Down Enter
check "enter switches the attached client to the selected session" 'retry client_on beta'
check "enter on a session goes to the ttop bar of its window" 'active_is beta "$BAR"'
check "and that ttop selects the session" 'retry shows_in "$BAR" "▌2 beta"'
$T send-keys -t "$BAR" Down
check "down there selects beta's agent, a row of its own" 'retry shows_in "$BAR" "▌ ○ idle"'
$T send-keys -t "$BAR" Down Enter
check "down goes round to alpha, and enter there switches back to alpha" 'retry client_on alpha'
check "where alpha's ttop selects alpha" 'retry shows_in "$TP" "▌1 *alpha"'
$T send-keys -t "$TP" Home Down Down Enter
check "enter on an agent goes to the agent's pane" 'retry client_on beta && active_is beta "$PANE2"'
# With synchronize-panes on, a key sent to one pane goes to all of them: then
# no key goes, and the bar keeps its selection.
CAT=$($T split-window -d -v -P -F '#{pane_id}' -t "$PANE2")
$T send-keys -t "$BAR" End
retry shows_in "$BAR" "▌ ○ idle"
$T set -w -t "$BAR" synchronize-panes on
switch_to alpha
$T send-keys -t "$TP" Home Down Enter
check "with synchronize-panes on, enter on a session still goes to the bar" \
  'retry client_on beta && active_is beta "$BAR"'
sleep 0.5
check "but sends no key, which the other panes would get too" '! shows_in "$CAT" "[.]" && shows_in "$BAR" "▌ ○ idle"'
$T set -w -t "$BAR" synchronize-panes off
# A bar whose ttop quit, kept by remain-on-exit, gets no focus.
$T set -w -t "$BAR" remain-on-exit on
$T send-keys -t "$BAR" q
retry eval '[ "$($T display -p -t "$BAR" "#{pane_dead}")" = 1 ]'
$T select-pane -t "$PANE2"
switch_to alpha
$T send-keys -t "$TP" Home Down Enter
check "a dead ttop pane gets no focus" 'retry client_on beta && active_is beta "$PANE2"'
$T kill-pane -t "$BAR"; $T kill-pane -t "$CAT"; $T set -w -t "$PANE2" -u remain-on-exit
$T send-keys -t "$TP" n
check "n switches the attached client to a new session" 'retry new_client >/dev/null'
NEW=$(new_client)
check "ttop selects the new session" '[ -n "$NEW" ] && retry shows_in "$TP" "▌.*$NEW"'
$T switch-client -c "$($T list-clients -F '#{client_name}')" -t beta
$T kill-session -t "=$NEW"

# Agents outside tmux. VS Code's agent panel runs Claude with TERM_PROGRAM=tmux
# but no TMUX; only its own variables say vscode. Enter marks a green one seen.
SID3=33333333-4444-5555-6666-777777777777
sleep 600 & FAKE3=$!
outside() {  # outside SID EVENT [extra JSON] [VAR=value ...]
  printf '{"session_id":"%s","hook_event_name":"%s","cwd":"%s","transcript_path":"%s"%s}' \
    "$1" "$2" "$D" "$D/transcript.jsonl" "${3:+,$3}" |
    env -u TMUX -u TMUX_PANE $(compgen -e | sed -n 's/^VSCODE_.*/-u &/p') \
      TERM_PROGRAM=tmux CLAUDE_PID="$FAKE3" CLAUDE_CODE_ENTRYPOINT=cli "${@:4}" "$TLS" hook
}
SID4=44444444-5555-6666-7777-888888888888
outside $SID4 SessionStart '"source":"startup"'
check "an agent outside tmux is labelled terminal" '[ "$(SID=$SID4 field "[\"where\"]")" = terminal ]'
outside $SID4 SessionEnd '"reason":"prompt_input_exit"'
outside $SID3 SessionStart '"source":"startup"' VSCODE_IPC_HOOK_CLI=/tmp/x
outside $SID3 Stop '"last_assistant_message":"All done.","background_tasks":[]'
check "VS Code's agent panel is labelled vscode" '[ "$(SID=$SID3 field "[\"where\"]")" = vscode ] && state_is $SID3 done'
check "ttop lists it under outside tmux" 'retry shows_in "$TP" "vscode tls-test.* ● done"'
$T send-keys -t "$TP" End
check "ttop can select an agent outside tmux" 'retry shows_in "$TP" "▌ .*vscode tls-test"'
$T send-keys -t "$TP" Enter
check "enter on it marks it seen" 'retry state_is $SID3 idle'

# beta's agent dies: d then Enter forgets it once it's selected.
kill "$FAKE2"; wait "$FAKE2" 2>/dev/null
check "ttop lists the dead agent" 'retry shows_in "$TP" "3 beta .*✕ was idle"'
$T send-keys -t "$TP" End
check "End selects the last row" 'retry shows_in "$TP" "▌3 beta .*✕"'
$T send-keys -t "$TP" d
check "d asks about the selected dead agent" 'retry shows_in "$TP" "forget dead agent beta?"'
$T send-keys -t "$TP" Enter
check "enter confirms: record forgotten" 'retry test ! -e "$D/state/$SID2.json"'
$T send-keys -t "$TP" q

# A session with two agents: a row of its own and a row per agent under it, by
# name (/rename), else by Claude's title. Del deletes an agent or a session. A
# dead agent comes back where it was: its whole session rebuilt, its pane split
# back into its window, or right in its pane when that sits at a shell prompt.
SID5=55555555-6666-7777-8888-999999999999
SID6=66666666-7777-8888-9999-aaaaaaaaaaaa
SID7=77777777-8888-9999-aaaa-bbbbbbbbbbbb
printf '{"type":"custom-title","customTitle":"fixer","sessionId":"%s"}\n' $SID5 > "$D/t5.jsonl"
printf '{"type":"ai-title","aiTitle":"Rebase the stack","sessionId":"%s"}\n' $SID6 > "$D/t6.jsonl"
: > "$D/t7.jsonl"
agent_in() {  # agent_in SID PANE PID EVENT [extra JSON]; transcript: $D/t<SID's first digit>.jsonl
  printf '{"session_id":"%s","hook_event_name":"%s","cwd":"%s","transcript_path":"%s"%s}' \
    "$1" "$4" "$D" "$D/t${1:0:1}.jsonl" "${5:+,$5}" |
    TMUX="$SOCK,1,0" TMUX_PANE="$2" CLAUDE_PID="$3" CLAUDE_CODE_ENTRYPOINT=cli "$TLS" hook
}
geom() { $T list-panes -t "$1" -F '#{pane_left},#{pane_top},#{pane_width}x#{pane_height}' | tr '\n' ' '; }
gone_pane() { ! $T list-panes -a -F '#{pane_id}' | grep -qx "$1"; }
no_session() { ! $T has-session -t "$1" 2>/dev/null; }
bring_back() { TLS_TMUX="-L $SRV" TLS_CLAUDE="echo claude" "$TLS" resume "$1" >/dev/null; }
$T new-session -d -s gamma -x 160 -y 40 "sleep 600"
G1=$($T display -p -t gamma '#{pane_id}')
G2=$($T split-window -d -h -P -F '#{pane_id}' -t "$G1" "sleep 600")
$T split-window -d -v -t "$G2"   # a plain pane (cat)
sleep 600 & FAKE5=$!
sleep 600 & FAKE6=$!
agent_in $SID5 "$G1" $FAKE5 SessionStart '"source":"startup"'
agent_in $SID6 "$G2" $FAKE6 SessionStart '"source":"startup"'
agent_in $SID6 "$G2" $FAKE6 Stop '"last_assistant_message":"Fixed it.\n\nShould I land it?","background_tasks":[]'
check "a session with two agents has a row of its own" 'view | grep -qE "^ *gamma *$"'
check "its agents have a row each under it, by name, else Claude's title" \
  'view | grep -qE "^ +○ idle +fixer +[0-9]+s$" && view | grep -qE "^ +● waiting +Rebase the stack +[0-9]+s  Should I land it\?$"'

# Vertical (-v), for a narrow window: a line with the session's name; under it,
# for each agent, a line with its dot, status, name and age, then its summary.
# Too narrow: the status words go first, then the names get cut, then the age.
vview() { env -u LINES COLUMNS=$1 ${2:+LINES=$2} TLS_TMUX="-L $SRV" "$TLS" -v; }   # vview WIDTH [HEIGHT]
widest() { /usr/bin/python3 -IS -c 'import sys; print(max(len(l) for l in sys.stdin.buffer.read().decode().splitlines()))'; }
check "tls -v: a session's name has a line of its own" 'vview 40 | grep -qx gamma'
check "tls -v: under it, a line for each agent: dot, status, whole name, age" \
  'vview 40 | grep -qE "^ ○ idle +fixer +[0-9]+[smhd]$" && vview 40 | grep -qE "^ ● waiting Rebase the stack +[0-9]+[smhd]$"'
check "tls -v: then the agent's summary, on a line of its own" \
  'vview 40 | grep -A1 "● waiting" | grep -qx " Should I land it?"'
check "tls -v in 24 columns: the status words go first, and the names stay whole" \
  'vview 24 | grep -qE "^ ● Rebase the stack +[0-9]+[smhd]$" && [ "$(vview 24 | widest)" -le 24 ]'
check "tls -v in 20 columns: then the names get cut" \
  'vview 20 | grep -qE "^ ● Rebase the s… +[0-9]+[smhd]$" && [ "$(vview 20 | widest)" -le 20 ]'
check "tls -v in 12 columns: still the dot, a name and the age" \
  'vview 12 | grep -qE "^ ○ fixer +[0-9]+[smhd]$" && [ "$(vview 12 | widest)" -le 12 ]'
check "tls -v in 12 columns: a summary goes on over more lines" \
  '[ "$(vview 12 | grep -A2 "^ ● Reba" | tail -n 2 | tr "\n" "|")" = " Should I| land it?|" ]'
check "tls -v in a short window: each summary gets one line, cut with …" \
  '[ "$(vview 12 5 | grep -A1 "^ ● Reba" | tail -n 1)" = " Should I…" ]'
wrap_py() {  # wrap_py TEXT WIDTH MOST HANG: tls's wrap(), its lines joined with |
  /usr/bin/python3 -ISB -c 'import importlib.machinery as m, importlib.util as u, sys
l = m.SourceFileLoader("tls", sys.argv[1]); t = u.module_from_spec(u.spec_from_loader("tls", l)); l.exec_module(t)
print("|".join(t.wrap(sys.argv[2], int(sys.argv[3]), int(sys.argv[4]), sys.argv[5])))' "$TLS" "$@"
}
check "a summary cut in a long word shows the start of the word, not a line of just …" \
  '[ "$(wrap_py "> someone@host:~\$ nohup ~/rebranch/scripts/snapshot_watch.sh" 23 2 "  ")" = "> someone@host:~\$ nohup|  ~/rebranch/scripts/s…" ]'
V=$($TT new-session -d -P -F '#{pane_id}' -s narrow -x 20 -y 30 \
  "env -u TMUX TLS_STATE_DIR='$D/state' TLS_TMUX='-L $SRV' '$HERE/ttop' -v")
check "ttop -v in a 20-column pane: each agent's lines go under its session" \
  'retry shows "$V" "^  ○ fixer  *[0-9][0-9]*[smhd]$" && shows "$V" "^  Should I land it?$" && shows "$V" "^ttop · [0-9:]*$"'
$TT send-keys -t "$V" Home Down Down Down Down
check "ttop -v: the bar covers all the lines of the selected agent" \
  'retry shows "$V" "^▌ ● Rebase the…" && $TT capture-pane -ep -t "$V" | grep "Should I land it" | grep -q "48;5;237"'
$TT resize-window -t narrow -y 6   # room for 5 lines of the list: a short window has no blank lines
# tmux drops the top lines of a pane it makes shorter: until ttop draws again,
# the old screen has no title, and it can look right.
short_ok() { shows "$V" "^ttop · " && shows "$V" "^▌ ● Rebase the…" && shows "$V" "Should I land it?" && ! shows "$V" alpha; }
check "ttop -v in a short pane: scrolling keeps all the lines of the selected agent in view" 'retry short_ok'
$TT send-keys -t "$V" q
check "ttop -v: q quits" 'retry exited_ok "$V"'
$TT kill-session -t narrow
check "ttop --help prints the help; an unknown option exits with 2" \
  '"$HERE/ttop" --help | grep -q "ttop \[-v | -h\]" && { "$HERE/ttop" -x >/dev/null; [ $? = 2 ]; }'
# Neither -v nor -h: ttop picks by the window's shape, again at each resize.
# Each step flips the layout, so the old screen cannot pass a check.
AU=$($TT new-session -d -P -F '#{pane_id}' -s auto -x 100 -y 20 \
  "env -u TMUX TLS_STATE_DIR='$D/state' TLS_TMUX='-L $SRV' '$HERE/ttop'")
hint_h() { shows "$1" "^↑↓ select · enter"; }
hint_v() { shows "$1" "^↑↓ enter n del R q$"; }
check "ttop with neither -v nor -h: horizontal in a 100x20 window" 'retry hint_h "$AU"'
$TT resize-window -t auto -x 100 -y 60
check "vertical in a window taller than wide (100x60 cells, 1:1.2 in pixels)" 'retry hint_v "$AU"'
$TT resize-window -t auto -x 160 -y 20
check "horizontal again in a 160x20 window" 'retry hint_h "$AU"'
$TT resize-window -t auto -x 40 -y 20
check "vertical in a window under 60 columns" 'retry hint_v "$AU"'
$TT kill-session -t auto
AH=$($TT new-session -d -P -F '#{pane_id}' -s autoh -x 40 -y 20 \
  "env -u TMUX TLS_STATE_DIR='$D/state' TLS_TMUX='-L $SRV' '$HERE/ttop' -h")
check "ttop -h stays horizontal in a 40-column window" 'retry hint_h "$AH"'
$TT kill-session -t autoh

P=$(term "'$HERE/ttop'")
retry shows "$P" "▌1 *alpha"
$TT send-keys -t "$P" Down Down Down
check "ttop selects an agent under its session" 'retry shows "$P" "▌ .*fixer"'
$TT send-keys -t "$P" DC
check "Delete asks before it kills an agent" 'retry shows "$P" "delete agent fixer (kills its pane)?"'
$TT send-keys -t "$P" Enter
check "enter kills the agent's pane" 'retry gone_pane "$G1"'
agent_in $SID5 "$G1" $FAKE5 SessionEnd '"reason":"other"'
check "the deleted agent stays out of the list, even after its last hooks" \
  '[ -n "$(SID=$SID5 field "[\"deleted\"]")" ] && ! view | grep -q fixer'
kill "$FAKE5"; wait "$FAKE5" 2>/dev/null

view >/dev/null   # saves gamma's structure, now without the deleted pane
GEOM=$(geom gamma)
$T kill-session -t gamma; kill "$FAKE6"; wait "$FAKE6" 2>/dev/null
check "ttop lists the dead agent under its session's name" 'retry shows "$P" "gamma .*✕ was waiting .*Rebase the stack"'
bring_back "${SID6:0:8}"
check "a killed session comes back with its splits" '[ "$(geom gamma)" = "$GEOM" ]'
NEW=$($T list-panes -t gamma -F '#{pane_id}' | head -1)
check "the agent resumes in its own pane; the other pane is a plain shell" \
  'retry shows_in "$NEW" "claude --resume $SID6" && ! $T capture-pane -p -t gamma:0.1 | grep -q resume'

sleep 600 & FAKE6=$!
agent_in $SID6 "$NEW" $FAKE6 SessionStart '"source":"resume"'
$T kill-pane -t "$NEW"; kill "$FAKE6"; wait "$FAKE6" 2>/dev/null
view >/dev/null
bring_back "${SID6:0:8}"
check "a closed agent pane is split back into its window, same layout" \
  '[ "$($T list-windows -t gamma | wc -l)" = 1 ] && [ "$(geom gamma)" = "$GEOM" ]'
check "and the agent resumes there" 'retry shows_in gamma:0.0 "claude --resume $SID6"'

$T new-session -d -s delta -x 160 -y 40 "env PS1='$ ' sh"
D1=$($T display -p -t delta '#{pane_id}')
cmd_is() { [ "$($T display -p -t "$1" '#{pane_current_command}')" = "$2" ]; }   # cmd_is PANE COMMAND
retry cmd_is "$D1" sh   # tls types a resume command only into a pane that runs a shell
sleep 600 & FAKE7=$!
agent_in $SID7 "$D1" $FAKE7 SessionStart '"source":"startup"'
kill "$FAKE7"; wait "$FAKE7" 2>/dev/null
bring_back "${SID7:0:8}"
check "an agent whose pane sits at a shell prompt resumes right there" \
  'retry shows_in "$D1" "^claude --resume $SID7" && [ "$($T list-panes -s -t delta | wc -l)" = 1 ]'

retry shows "$P" " 3 *delta"   # ttop refreshes once a second: keys go to the rows it shows
$TT send-keys -t "$P" Home Down Down
check "ttop selects the delta session" 'retry shows "$P" "▌3 *delta"'
$TT send-keys -t "$P" BSpace
check "Backspace asks before it kills a session" 'retry shows "$P" "delete session delta: 1 pane, 0 agents?"'
$TT send-keys -t "$P" Escape
check "esc keeps the session" 'retry shows "$P" cancelled && $T has-session -t delta'
$TT send-keys -t "$P" BSpace Enter
check "enter kills the session" 'retry no_session delta'
$TT send-keys -t "$P" q

# tmux-agents.bash. Session names match exactly: on its own, tmux resolves "pf"
# to "pfx" when there's no "pf", so t opened, trm killed and tmv refused the
# wrong session.
LIB="$HERE/tmux-agents.bash"; [ -f "$LIB" ] || LIB="$HERE/../shell/tmux-agents.bash"
lib() {  # lib CODE: run bash CODE with tmux-agents.bash loaded, against the test server
  bash --norc --noprofile -c "tmux() { command tmux -L $SRV \"\$@\"; }; . '$LIB'; $1"
}
letters() {  # tls has one adjective and one noun per letter
  /usr/bin/python3 -I -S -B - "$TLS" <<'PY'
import importlib.machinery, importlib.util, sys
loader = importlib.machinery.SourceFileLoader("tls", sys.argv[1])
tls = importlib.util.module_from_spec(importlib.util.spec_from_loader("tls", loader))
loader.exec_module(tls)
abc = "abcdefghijklmnopqrstuvwxyz"
sys.exit(not all("".join(sorted(w[0] for w in ws)) == abc for ws in (tls.ADJECTIVES, tls.NOUNS)))
PY
}
check "session names: one adjective and one noun per letter" 'letters'
NAME=$(TLS_TMUX="-L $SRV" "$TLS" new-name)
check "new-name prints a free adjective-noun name" '[[ $NAME =~ ^[a-z]+-[a-z]+$ ]] && no_session "$NAME"'
$T new-session -d -s pfxlong "sleep 600"
lib 'trm pfx' 2>/dev/null
check "trm leaves alone a session whose name only starts with it" '$T has-session -t =pfxlong'
lib 'tmv pfxlong pfx' >/dev/null 2>&1
check "tmv takes a name that only starts another session's name" '$T has-session -t =pfx && no_session pfxlong'
# Bad names. TMUX puts t on its inside-tmux path, where an old t made a session
# of any word: `t -p` made "-p". tmux keeps "foo.bar" (older ones make it
# "foo_bar"), but a target reads the dot as a separator.
TMUX="$SOCK,1,0" lib 't -x; t "a b"; t foo.bar; t ab cd; tmv pfx -y; tmv pfx "a b"' > "$D/names" 2>&1
check "t refuses an unknown option or two names; t and tmv refuse a name with symbols or - first" \
  '[ "$(grep -c "^t: unknown option .-x.\|^t: more than one NAME\|^t: bad session name .a b.\|^t: bad session name .foo.bar.\|^tmv: bad session name .-y.\|^tmv: bad session name .a b." "$D/names")" = 6 ]'
check "and they make or rename no session" \
  '$T has-session -t =pfx && ! $T list-sessions -F "#{session_name}" | grep -qxF -e -x -e "a b" -e foo.bar -e foo_bar -e ab -e -y'
$T new-session -d -s -p "sleep 600"; $T new-session -d -s -q "sleep 600"
lib 'tmv -p pgood; trm -q' >/dev/null 2>&1
check "tmv and trm still take a bad old name, to fix or remove its session" \
  '$T has-session -t =pgood && no_session =-p && no_session =-q'
$T kill-session -t =pgood
printf '%s\n' "tmux() { command tmux -L $SRV \"\$@\"; }" ". '$LIB'" "t pf" > "$D/t-outside"
term "bash --norc --noprofile '$D/t-outside'" >/dev/null
check "t outside tmux opens the exact session, creating it" 'retry client_on pf && $T has-session -t =pfx'
$T detach-client -s pf
$T new-session -d -s zzlong "sleep 600"
printf '%s\n' "tls() { '$TLS' \"\$@\"; }" ". '$LIB'" "t zz" > "$D/t-inside"
$T new-window -d -t beta: "bash --norc --noprofile '$D/t-inside'"
check "t inside tmux switches to the exact session, creating it" 'retry client_on zz'
printf '%s\n' "tls() { '$TLS' \"\$@\"; }" ". '$LIB'" "t" > "$D/t-new"
$T new-window -d -t zz: "bash --norc --noprofile '$D/t-new'"
check "t with no name opens a new adjective-noun session" 'retry new_client >/dev/null'
NEW=$(new_client)
$T switch-client -c "$($T list-clients -F '#{client_name}' | head -1)" -t beta
for s in pf pfx zz zzlong "$NEW"; do $T kill-session -t "=$s" 2>/dev/null; done
# tmux_autostart on a terminal: tmux in its session; the shell ends with tmux.
printf '%s\n' "tmux() { command tmux -L $SRV \"\$@\"; }" ". '$LIB'" "tmux_autostart autost" > "$D/autostart"
A=$($TT new-window -d -P -F '#{pane_id}' -t term: "env -u TMUX TERM=xterm-256color bash --norc --noprofile -i '$D/autostart'")
check "tmux_autostart puts a terminal in its session" 'retry client_on autost'
$T detach-client -s autost
check "and its shell ends when tmux detaches" 'retry exited_ok "$A"'
$T kill-session -t =autost
# Tmux upgrade resilience: tmux-doctor finds the server and its binary, and the
# client cache gets a working copy of that binary.
VER=$($T display -p '#{version}')
export TMUX_CLIENT_CACHE="$D/clients"
check "tmux-doctor shows the server's pid and binary" \
  'out=$(lib tmux-doctor) && [[ $out == *"running server: $VER (pid $($T display -p "#{pid}"))"* ]] && [[ $out == *"server exe    : /"* ]]'
lib "_tmux_cache_server_binary $VER"
check "the client cache gets a working copy of the server's binary" '[ "$("$D/clients/tmux-$VER" -V)" = "tmux $VER" ]'
unset TMUX_CLIENT_CACHE

# The agent-neutral interface: any agent reports with tls report.
SID9=codex-0001
$T new-session -d -s eps -x 160 -y 40 "sleep 600"
E1=$($T display -p -t eps '#{pane_id}')
sleep 600 & FAKE9=$!
rep() { TMUX="$SOCK,1,0" TMUX_PANE="$E1" "$TLS" report "$@"; }
rep id=$SID9 agent=codex pid=$FAKE9 state=busy prompt="port the parser" name=porter resume="codex resume $SID9"
check "report: any agent shows up, by name, with its prompt" 'view | grep -qE "^eps +◐ busy +porter +[0-9]+s  > port the parser$"'
check "tls -v: a prompt goes on under its text, not under its >" \
  'vview 12 | grep -qx " > port the" && vview 12 | grep -qx "   parser"'
printf '{"id": "%s", "state": "waiting", "summary": "Push to main?"}' $SID9 | rep
check "report: one JSON object on stdin works too" 'view | grep -qE "^eps +● waiting +porter .*  Push to main\?$"'
rep id=$SID9 state=finished message="Pushed. Want me to also tag a release?"
check "report: finished lets tls tell done from waiting" 'view | grep -qE "^eps +● done +porter .*  Pushed. Want me to also tag a release\?$"'
check "report: a bad report is refused, with the reason" \
  'out=$("$TLS" report id=$SID9 state=sleepy 2>&1); [ $? = 2 ] && [[ $out == *"state must be"* ]]'
rep id=$SID9 state=busy
kill "$FAKE9"; wait "$FAKE9" 2>/dev/null
check "report: a dead agent waits under its session, as was busy (the live word)" 'view | grep -qE "^eps +✕ was busy +porter"'
bring_back "$SID9"
check "report: bringing it back types the resume command it reported" 'retry shows_in eps:1 "codex resume $SID9"'
rep id=$SID9 end=deliberate
check "report: end=deliberate drops the session" '[ ! -e "$D/state/$SID9.json" ]'
$T kill-session -t =eps

# Presets: a bar with ttop, and the rest of the window in two panes side by
# side. A wide window (21:9) gets the bar on the right, 25 columns, with ttop -v;
# another window gets it at the bottom, 5 to 10 lines high.
panes_of() { $T list-panes -t "=$1:" -F '#{pane_left},#{pane_top} #{pane_width}x#{pane_height} #{pane_active} #{pane_start_command}'; }
side_by_side() {  # side_by_side SESSION: two panes besides the bar, as wide as each other, the first one active
  panes_of "$1" | grep -v ttop | awk '{split($2, s, "x"); w[NR] = s[1]; a[NR] = $3}
    END {d = w[1] - w[2]; exit !(NR == 2 && d * d <= 4 && a[1] == 1)}'   # 2: tmux gives the odd column to the first
}
bar_at() {  # bar_at SESSION right|bottom: its last pane is a bar along that edge, with ttop -v or -h, -p -f
  $T list-panes -t "=$1:" -F '#{pane_left} #{pane_top} #{pane_width} #{pane_height} #{window_width} #{window_height} #{pane_start_command}' |
    awk -v side="$2" 'END { if (side == "right") ok = $1 + $3 == $5 && $2 == 0 && $4 == $6 && $3 >= 16 && $3 <= 40 && /ttop.? -v -p -f/
                            else ok = $2 + $4 == $6 && $1 == 0 && $3 == $5 && /ttop.? -h -p -f/
                            exit !ok }'
}
nested() {  # nested SESSION: the two panes have a cell of their own in the layout, so they share the bar's changes
  $T display -p -t "=$1:" '#{window_layout}' | grep -qE '^[0-9a-f]{4},[0-9]+x[0-9]+,0,0\{[0-9]+x[0-9]+,0,0\{'
}
preset() { TLS_TMUX="-L $SRV" "$TLS" preset "$@"; }
$T new-session -d -s wide -x 300 -y 60 "sleep 600"
preset =wide:
check "preset in a wide window: a bar on the right with ttop -v -p -f, two panes besides it in a cell of their own" \
  '[ "$(panes_of wide | wc -l)" = 3 ] && bar_at wide right && side_by_side wide && nested wide'
$T new-session -d -s std -x 200 -y 56 "sleep 600"
preset =std:
check "preset in a 16:9 window: a bar at the bottom with ttop -h -p -f, two panes above it" \
  '[ "$(panes_of std | wc -l)" = 3 ] && bar_at std bottom && side_by_side std'
$T new-session -d -s forced -x 300 -y 60 "sleep 600"
TLS_PRESET=bottom preset =forced:
check "TLS_PRESET=bottom puts the bar at the bottom of a wide window too, and tells its ttop" \
  'bar_at forced bottom && panes_of forced | grep -qE "TLS_PRESET=bottom .*ttop.? -h -p -f"'
check "preset leaves alone a window with more than one pane" \
  'out=$(preset =wide: 2>&1); [ $? = 1 ] && [[ $out == *"a preset needs a window with one"* ]] && [ "$(panes_of wide | wc -l)" = 3 ]'
for s in wide std forced; do $T kill-session -t "=$s"; done
printf '%s\n' "tls() { '$TLS' \"\$@\"; }" ". '$LIB'" "t -p" > "$D/t-preset"
$T new-window -d -t beta: "bash --norc --noprofile '$D/t-preset'"
check "t -p makes a new session with a free name in the preset layout, and switches to it" \
  'retry new_client >/dev/null && PZ=$(new_client) && [ "$(panes_of "$PZ" | wc -l)" = 3 ] && side_by_side "$PZ" &&
   bar_at "$PZ" bottom && no_session =-p'
NEW=$(new_client)
$T switch-client -c "$($T list-clients -F '#{client_name}' | head -1)" -t beta
$T kill-session -t "=$NEW"
TP=$($T new-window -P -F '#{pane_id}' -t beta: "env TLS_STATE_DIR='$D/state' '$HERE/ttop' -p")
retry shows_in "$TP" "▌1"
$T send-keys -t "$TP" n
check "ttop -p: n makes its new session in the preset layout" \
  'retry new_client >/dev/null && [ "$(panes_of "$(new_client)" | wc -l)" = 3 ]'
NEW=$(new_client)
$T switch-client -c "$($T list-clients -F '#{client_name}' | head -1)" -t beta
$T kill-session -t "=$NEW"; $T kill-pane -t "$TP"
B=$($TT new-session -d -P -F '#{pane_id}' -s bar -x 200 -y 8 \
  "env -u TMUX TLS_STATE_DIR='$D/state' TLS_TMUX='-L $SRV' '$HERE/ttop'")
check "ttop in an 8-line bar: the key hint on the title line, and no blank lines" \
  'retry shows "$B" "^ttop · .* · ↑↓ select" && [ -n "$($TT capture-pane -p -t "$B" | sed -n 2p)" ]'
$TT kill-session -t bar
SID8=88888888-9999-aaaa-bbbb-cccccccccccc
: > "$D/t8.jsonl"
$T new-session -d -s pre -x 300 -y 60 "sleep 600"
preset =pre:
sleep 600 & FAKE8=$!
agent_in $SID8 "$($T display -p -t =pre: '#{pane_id}')" $FAKE8 SessionStart '"source":"startup"'
view >/dev/null   # saves pre's structure, the bar too
$T kill-session -t =pre; kill "$FAKE8"; wait "$FAKE8" 2>/dev/null
bring_back "${SID8:0:8}"
check "a rebuilt preset session gets its splits back, and ttop in its bar" \
  '[ "$(panes_of pre | wc -l)" = 3 ] && bar_at pre right && side_by_side pre && nested pre'
$T kill-session -t =pre

# Fit (ttop -f): ttop sizes its own pane to the list. With an empty state dir
# the list is just the sessions: the vertical bar is as wide as the longest
# name and its key (3 + name + 1 for the last column, 16 to 40 columns); the
# horizontal one has a line for each session and the title (under 12 lines).
FITS="$D/fitstate"
nat_py() {  # nat_py STATE: the vertical list's width for a session "s" whose agent "agent-name" is in STATE
  /usr/bin/python3 -ISB -c 'import importlib.machinery as m, importlib.util as u, sys
l = m.SourceFileLoader("tls", sys.argv[1]); t = u.module_from_spec(u.spec_from_loader("tls", l)); l.exec_module(t)
print(t.natural_width([dict(t.BLANK, kind="session", name="s", key="1", state=sys.argv[2], label="agent-name")]))' "$TLS" "$1"
}
check "ttop -v -f keeps room for the longest status word, so a change of state resizes nothing" \
  '[ "$(nat_py working)" = 26 ] && [ "$(nat_py waiting)" = 26 ] && [ "$(nat_py idle)" = 26 ]'   # 7 + 10 + 9
size_is() { [ "$($T display -p -t "$1" '#{pane_width}x#{pane_height}')" = "$2" ]; }   # size_is PANE WxH
want_v() {
  $T list-sessions -F '#{session_name}#{?session_attached,*,}' |
    awk '{ if (length > n) n = length } END { n += 4; print (n < 16 ? 16 : n > 40 ? 40 : n) }'
}
want_h() { $T list-sessions | awk 'END { n = NR + 1 < 12 ? NR + 1 : NR + 4; print (n > 16 ? 16 : n) }'; }   # 16: 50 / 3
$T new-session -d -s fitv -x 200 -y 50 "sleep 600"
FV=$($T split-window -d -h -l 50 -t =fitv: -P -F '#{pane_id}' "env TLS_STATE_DIR='$FITS' '$HERE/ttop' -v -f")
check "ttop -v -f: the pane gets as wide as the longest line" 'retry size_is "$FV" "$(want_v)x50"'
$T new-session -d -s fit-check-a-rather-long-name-x "sleep 600"
check "it grows when a longer session name comes" 'retry size_is "$FV" 34x50'
$T kill-session -t =fit-check-a-rather-long-name-x
check "and shrinks when the name goes" 'retry size_is "$FV" "$(want_v)x50"'
$T resize-pane -t "$FV" -x 60
check "a drag of its edge snaps back" 'retry size_is "$FV" "$(want_v)x50"'
$T kill-session -t =fitv
$T new-session -d -s fith -x 200 -y 50 "sleep 600"
FH=$($T split-window -d -v -l 20 -t =fith: -P -F '#{pane_id}' "env TLS_STATE_DIR='$FITS' '$HERE/ttop' -h -f")
check "ttop -h -f: the pane gets as high as the list and its title" 'retry size_is "$FH" "200x$(want_h)"'
$T new-session -d -s fit1 "sleep 600"; $T new-session -d -s fit2 "sleep 600"
check "it grows by a line for each new session" 'retry size_is "$FH" "200x$(want_h)"'
$T kill-session -t =fit1; $T kill-session -t =fit2
check "and shrinks when they go" 'retry size_is "$FH" "200x$(want_h)"'
$T kill-session -t =fith

# ttv: a bar with ttop -v, 25 columns wide and as high as the window, on the
# right of any window over 80 columns. tmux takes the room from all the panes,
# in proportion to their widths. In a cell of their own, the panes also share
# the room again when the bar closes (in equal parts: tmux does that).
ttv() { TLS_TMUX="-L $SRV" "$HERE/ttv" "$@"; }   # always with a window: TMUX_PANE can be your own pane
geom() { $T list-panes -t "=$1:" -F '#{pane_id} #{pane_width} #{pane_height}'; }
same_geom() { [ "$(geom "$1")" = "$2" ]; }
ttv_bar() {  # ttv_bar SESSION: its last pane is a bar along the right edge, 25 columns, as high as the window, with ttop -v
  $T list-panes -t "=$1:" -F '#{pane_left} #{pane_top} #{pane_width} #{pane_height} #{window_width} #{window_height} #{pane_start_command}' |
    awk 'END { exit !($1 + $3 == $5 && $2 == 0 && $3 == 25 && $4 == $6 && /ttop.? -v"?$/) }'
}
squeezed() {  # squeezed SESSION BEFORE: each pane of BEFORE (geom) kept its height and lost width in proportion, to the column
  # BEFORE goes in through ENVIRON: BSD awk (macOS) refuses a newline in a -v value.
  geom "$1" | BEFORE="$2" awk -v W="$($T display -p -t "=$1:" '#{window_width}')" '
    BEGIN { n = split(ENVIRON["BEFORE"], b, "\n"); for (i = 1; i <= n; i++) { split(b[i], f, " "); w[f[1]] = f[2]; h[f[1]] = f[3] } }
    $1 in w { d = $2 - w[$1] * (W - 26) / W; if (d * d >= 1 || $3 != h[$1]) bad = 1; seen++ }
    END { exit !(seen == n && !bad) }'
}
$T new-session -d -s tv1 -x 101 -y 30 "sleep 600"; $T split-window -d -h -t =tv1: "sleep 600"
G1=$(geom tv1)
ttv =tv1:
check "ttv: a bar of 25 columns with ttop -v on the right, as high as the window; two panes give up room in proportion" \
  'ttv_bar tv1 && squeezed tv1 "$G1" && nested tv1'
TV=$($T list-panes -t =tv1: -F '#{pane_id}' | tail -1)
check "the bar's ttop shows the list vertically" 'retry shows_in "$TV" "^↑↓ enter n del R q$"'
$T send-keys -t "$TV" q
check "q in the bar closes it, and the two panes share its room again" 'retry same_geom tv1 "$G1"'
$T new-session -d -s tv2 -x 121 -y 40 "sleep 600"
$T split-window -d -h -l 80 -t =tv2: "sleep 600"; $T split-window -d -v -t =tv2:.1 "sleep 600"; $T select-pane -t =tv2:.2
G2=$(geom tv2); C2=$($T display -p -t =tv2:.2 '#{pane_id}')
TMUX_PANE="$C2" TLS_TMUX="-L $SRV" "$HERE/ttv"
check "ttv in any layout (here a pane, and two above each other): heights stay, widths shrink in proportion, the cursor stays" \
  'ttv_bar tv2 && squeezed tv2 "$G2" && [ "$($T display -p -t =tv2: "#{pane_id}")" = "$C2" ]'
$T new-session -d -s tv3 -x 121 -y 40 "sleep 600"
$T split-window -d -v -t =tv3: "sleep 600"; $T split-window -d -h -t =tv3:.0 "sleep 600"
G3=$(geom tv3)
ttv =tv3:
check "ttv in a window split top and bottom: the same" 'ttv_bar tv3 && squeezed tv3 "$G3"'
$T resize-pane -t "$($T list-panes -t =tv2: -F '#{pane_id}' | tail -1)" -x 35
check "ttv in a window with a ttv bar adds no second bar, and sets the bar back to 25 columns" \
  'ttv =tv2: && [ "$(geom tv2 | wc -l)" = 4 ] && ttv_bar tv2'
$T new-session -d -s tv5 -x 120 -y 30 "sleep 600"; $T split-window -d -h -t =tv5: "sleep 600"
$T split-window -d -v -l 8 -t =tv5:.1 "'$HERE/ttop' -h"   # in a corner: not a bar
check "ttv adds no bar to a window with a ttop pane that is not a bar" \
  'out=$(ttv =tv5: 2>&1); [ $? = 1 ] && [[ $out == *"already runs ttop, but not as a bar"* ]] && [ "$(geom tv5 | wc -l)" = 3 ]'
$T new-session -d -s tv4 -x 80 -y 24 "sleep 600"
check "ttv leaves alone a window of 80 columns" \
  'out=$(ttv =tv4: 2>&1); [ $? = 1 ] && [[ $out == *"80 columns wide"* ]] && [ "$(geom tv4 | wc -l)" = 1 ]'
check "ttv with no window outside tmux says so" \
  'out=$(env -u TMUX_PANE TLS_TMUX="-L $SRV" "$HERE/ttv" 2>&1); [ $? = 1 ] && [[ $out == *"not in tmux"* ]]'
for s in tv1 tv2 tv3 tv4 tv5; do $T kill-session -t "=$s"; done

# tth: the same along the bottom edge, with ttop -h, 10 lines high: for a
# screen that is taller than wide. A bar on the other side moves.
tth() { TLS_TMUX="-L $SRV" "$HERE/tth" "$@"; }
tth_bar() {  # tth_bar SESSION: its last pane is a bar along the bottom edge, 10 lines, as wide as the window, with ttop -h
  $T list-panes -t "=$1:" -F '#{pane_left} #{pane_top} #{pane_width} #{pane_height} #{window_width} #{window_height} #{pane_start_command}' |
    awk 'END { exit !($2 + $4 == $6 && $1 == 0 && $4 == 10 && $3 == $5 && /ttop.? -h"?$/) }'
}
squeezed_v() {  # squeezed_v SESSION BEFORE: each pane of BEFORE (geom) kept its width and lost height in proportion, to the line
  # BEFORE goes in through ENVIRON, as in squeezed.
  geom "$1" | BEFORE="$2" awk -v H="$($T display -p -t "=$1:" '#{window_height}')" '
    BEGIN { n = split(ENVIRON["BEFORE"], b, "\n"); for (i = 1; i <= n; i++) { split(b[i], f, " "); w[f[1]] = f[2]; h[f[1]] = f[3] } }
    $1 in w { d = $3 - h[$1] * (H - 11) / H; if (d * d >= 1 || $2 != w[$1]) bad = 1; seen++ }
    END { exit !(seen == n && !bad) }'
}
nested_v() { $T display -p -t "=$1:" '#{window_layout}' | grep -qE '^[0-9a-f]{4},[0-9]+x[0-9]+,0,0\[[0-9]+x[0-9]+,0,0\['; }
ttops_in() { $T list-panes -t "=$1:" -F '#{pane_start_command}' | grep -c ttop; }
$T new-session -d -s th1 -x 120 -y 59 "sleep 600"; $T split-window -d -v -t =th1: "sleep 600"
G=$(geom th1)
tth =th1:
check "tth: a bar of 10 lines with ttop -h at the bottom, as wide as the window; the panes give up height in proportion" \
  'tth_bar th1 && squeezed_v th1 "$G" && nested_v th1'
$T resize-pane -t "$($T list-panes -t =th1: -F '#{pane_id}' | tail -1)" -y 15
check "tth in a window with a tth bar sets it back to 10 lines" 'tth =th1: && tth_bar th1 && [ "$(geom th1 | wc -l)" = 3 ]'
$T new-session -d -s th2 -x 120 -y 40 "sleep 600"; $T split-window -d -h -t =th2: "sleep 600"
tth =th2:
check "tth in a window split side by side: the panes keep their widths, and the bar spans them" \
  'tth_bar th2 && [ "$(geom th2 | awk "NR < 3 { print \$2 \"x\" \$3 }" | tr "\n" " ")" = "60x29 59x29 " ]'
ttv =th2:
check "ttv in a window with a tth bar moves the bar to the right" 'ttv_bar th2 && [ "$(ttops_in th2)" = 1 ] && [ "$(geom th2 | wc -l)" = 3 ]'
tth =th2:
check "and tth moves it back to the bottom" 'tth_bar th2 && [ "$(ttops_in th2)" = 1 ] && [ "$(geom th2 | wc -l)" = 3 ]'
$T new-session -d -s th5 -x 120 -y 40 "'$HERE/ttop' -v"   # ttop is the whole window: not a bar to move
check "tth leaves alone a window that is all ttop, and does not close it" \
  'out=$(tth =th5: 2>&1); [ $? = 1 ] && [[ $out == *"not as a bar"* ]] && [ "$(geom th5 | wc -l)" = 1 ]'
$T kill-session -t =th5
$T new-session -d -s th4 -x 120 -y 29 "sleep 600"
check "tth leaves alone a window of 29 lines" \
  'out=$(tth =th4: 2>&1); [ $? = 1 ] && [[ $out == *"29 lines high"* ]] && [ "$(geom th4 | wc -l)" = 1 ]'
$TT new-session -d -s thterm -x 120 -y 60 "env -u TMUX tmux -L $SRV attach -t =th1"
retry client_on th1
bar_h() { [ "$($T list-panes -t =th1: -F '#{pane_height}' | tail -1)" = "$1" ]; }
$TT resize-window -t thterm -x 120 -y 82
check "a window gets taller than wide (cells of 1 x 2): the tth bar gets 12 lines" 'retry bar_h 12'
$TT resize-window -t thterm -x 120 -y 42
check "and back to wider than tall: 10 lines again" 'retry bar_h 10'
$TT kill-session -t thterm
for s in th1 th2 th4; do $T kill-session -t "=$s"; done

# Resize in proportion. tmux takes the same number of columns from each pane,
# so the ttv bar went down to 1 column. tls's window-resized hook gives the
# panes their proportions back, and a ttop bar keeps its width. A client in the
# stand-in terminal changes the window's size, as a move to another monitor does.
$T new-session -d -s rs -x 300 -y 60 "sleep 600"; $T split-window -d -h -l 99 -t =rs: "sleep 600"
ttv =rs:
check "ttv in a wide window (300 x 60 cells of 1 x 2: 2.5 to 1): a bar of 30 columns" '[ "$(geom rs | awk "END { print \$2 }")" = 30 ]'
G0=$(geom rs)
$TT new-session -d -s rsterm -x 300 -y 61 "env -u TMUX tmux -L $SRV attach -t =rs"
retry client_on rs
in_proportion() {  # in_proportion BEFORE BAR: in rs, the bar has BAR columns, and the two panes share the rest as in BEFORE (geom)
  # BEFORE goes in through ENVIRON, as in squeezed.
  geom rs | BEFORE="$1" awk -v bar="$2" -v W="$($T display -p -t =rs: '#{window_width}')" '
    BEGIN { split(ENVIRON["BEFORE"], b, "\n"); split(b[1], p, " "); a0 = p[2]; split(b[2], p, " "); b0 = p[2] }
    { w[NR] = $2 }
    END { room = W - bar - 2; d = w[1] - room * a0 / (a0 + b0); exit !(NR == 3 && w[3] == bar && w[1] + w[2] == room && d * d < 1) }'
}
$TT resize-window -t rsterm -x 200 -y 61
check "a window gets narrower, not wide now: its panes keep their proportions, and the ttv bar gets 25 columns" 'retry in_proportion "$G0" 25'
$TT resize-window -t rsterm -x 300 -y 61
check "back at the old size, the old layout comes back exactly" 'retry same_geom rs "$G0"'
$TT resize-window -t rsterm -x 400 -y 61
check "a window gets wider, wide again: the ttv bar gets 30 columns, no more" 'retry in_proportion "$G0" 30'
$TT resize-window -t rsterm -x 300 -y 61
retry same_geom rs "$G0"
$T new-session -d -s rs2 -x 300 -y 60 "sleep 600"
$T split-window -d -h -l 99 -t =rs2: "sleep 600"; $T split-window -d -v -l 20 -t =rs2:.1 "sleep 600"
$T switch-client -c "$($T list-clients -t =rs -F '#{client_name}')" -t =rs2
retry client_on rs2
rs2_ok() {  # A | (B over C): from 200 | 99, and 39 over 20, at 300x60 to 200x40
  geom rs2 | awk '{ w[NR] = $2; h[NR] = $3 }
    END { a = w[1] - 199 * 200 / 299; b = h[2] - 39 * 39 / 59; c = h[3] - 39 * 20 / 59
          exit !(a * a < 1 && b * b < 1 && c * c < 1 && w[2] == 199 - w[1] && w[3] == w[2] && h[1] == 40) }'
}
$TT resize-window -t rsterm -x 200 -y 41
check "with no bar, in both directions: widths and heights keep their proportions" 'retry rs2_ok'
$T resize-pane -t =rs2:.0 -x 100
$TT resize-window -t rsterm -x 300 -y 61
drag_kept() { geom rs2 | awk 'NR == 1 { d = $2 - 100 * 299 / 199; exit !(d * d < 1) }'; }
check "a change you make at the new size is what the next resize keeps" 'retry drag_kept'
$T switch-client -c "$($T list-clients -t =rs2 -F '#{client_name}')" -t =rs
retry client_on rs
printf '[resize]\nproportional = off\n' > "$TLS_CONFIG"
$TT resize-window -t rsterm -x 200 -y 61
width_is() { [ "$($T display -p -t "=$1:" '#{window_width}')" = "$2" ]; }
retry width_is rs 200; sleep 1   # time for a relayout, if one runs: tmux's layout shows until then
bar_crushed() { [ "$(geom rs | awk 'END { print $2 }')" -lt 25 ]; }
check "proportional = off in tls.conf: tmux resizes the panes its own way" 'bar_crushed'
rm -f "$TLS_CONFIG"
$TT kill-session -t rsterm
$T new-session -d -s rs3 -x 200 -y 50 "sleep 600"; $T split-window -d -h -t =rs3: "sleep 600"
$T set -wu -t =rs3: @tls-base; $T set -wu -t =rs3: @tls-size   # as if it was split before tls added its hooks
$T new-session -d -s rs4 -x 200 -y 50 "sleep 600"
ttv =rs4:   # adds the hooks again
check "a window split before tls added its hooks gets its layout of then kept" \
  '[ "$($T show -wv -t =rs3: @tls-base)" = "$($T display -p -t =rs3: "#{window_layout}")" ] && [ "$($T show -wv -t =rs3: @tls-size)" = 200x50 ]'
for s in rs rs2 rs3 rs4; do $T kill-session -t "=$s"; done

# Bars keep their size: when you switch to a pane, window or session, a ttv
# or tth bar that lost its size, as after a drag, gets it back, and the other
# panes share the change in proportion. (tmux runs no hook for a select-pane
# of the pane that is active already.)
shared() {  # shared SESSION BEFORE FIELD BAR: the last pane is BAR along FIELD of geom (2 width, 3 height), and
            # the other panes share the rest in proportion to BEFORE (geom), to the cell; BEFORE through ENVIRON
  geom "$1" | BEFORE="$2" awk -v f="$3" -v bar="$4" '
    BEGIN { n = split(ENVIRON["BEFORE"], b, "\n"); for (i = 1; i <= n; i++) { split(b[i], g, " "); old[i] = g[f]; if (i < n) sum += g[f] }
            room = sum + old[n] - bar }
    { now[NR] = $f }
    END { if (NR != n || now[n] != bar) exit 1
          for (i = 1; i < n; i++) { d = now[i] - room * old[i] / sum; if (d * d >= 1) exit 1 }
          exit 0 }'
}
widths() { geom "$1" | awk '{ printf "%s ", $2 }'; }
widths_are() { [ "$(widths "$1")" = "$2" ]; }
$T new-session -d -s kb -x 160 -y 40 "sleep 600"; $T split-window -d -h -t =kb: "sleep 600"
ttv =kb:
KB=$($T list-panes -t =kb: -F '#{pane_id}' | tail -1)
$T resize-pane -t "$KB" -x 35
G=$(geom kb)
$T select-pane -t =kb:.1
check "a switch to a pane gives a ttv bar dragged to 35 columns its 25 back, shared in proportion" \
  '[[ $G == *" 35 40" ]] && retry shared kb "$G" 2 25'
$T new-session -d -s kh -x 120 -y 40 "sleep 600"; $T split-window -d -v -t =kh: "sleep 600"
tth =kh:
$T resize-pane -t "$($T list-panes -t =kh: -F '#{pane_id}' | tail -1)" -y 15
G=$(geom kh)
$T select-pane -t =kh:.1
check "the same for a tth bar dragged to 15 lines: 10 lines again" '[[ $G == *" 120 15" ]] && retry shared kh "$G" 3 10'
# A switch to a window, an attach, and a switch to a session do the same.
SET=$(widths kb)
drag_kb() { $T resize-pane -t "$KB" -x 35; DRAGGED=$(widths kb); }
$T new-window -d -t =kb: "sleep 600"
drag_kb; $T select-window -t =kb:1; $T select-window -t =kb:0
check "a switch to the window" '[ "$DRAGGED" != "$SET" ] && retry widths_are kb "$SET"'
drag_kb
$TT new-session -d -s kbterm -x 160 -y 41 "env -u TMUX tmux -L $SRV attach -t =kb"
check "an attach to the session" '[ "$DRAGGED" != "$SET" ] && retry widths_are kb "$SET"'
$T new-session -d -s kb2 -x 160 -y 40 "sleep 600"
KBC=$($T list-clients -t =kb -F '#{client_name}')
$T switch-client -c "$KBC" -t =kb2; retry client_on kb2
drag_kb; $T switch-client -c "$KBC" -t =kb
check "a switch to the session" '[ "$DRAGGED" != "$SET" ] && retry widths_are kb "$SET"'
# A bar at its size: no new layout. A hook of the test counts select-layout.
$T set-hook -g 'after-select-layout[44]' "run-shell 'echo x >> $D/layouts'"
$T select-pane -t =kb:.0; $T select-pane -t =kb:.1; sleep 1
check "a switch where the bar has its size makes no new layout" '[ ! -e "$D/layouts" ] && widths_are kb "$SET"'
$T set-hook -gu 'after-select-layout[44]'
printf '[resize]\nkeep-bars = off\n' > "$TLS_CONFIG"
drag_kb; $T select-pane -t =kb:.0; sleep 1
check "keep-bars = off in tls.conf: a drag stays, also before tls takes its hooks away" \
  '[ "$(widths kb)" = "$DRAGGED" ] && [ "$DRAGGED" != "$SET" ]'
$T new-session -d -s kb3 -x 160 -y 40 "sleep 600"
ttv =kb3:   # adds the hooks again, now without the ones at [43]
check "and then tls takes its hooks at [43] away" '! $T show-hooks -g "after-select-pane[43]" | grep -qF "$TLS bars"'
rm -f "$TLS_CONFIG"
$TT kill-session -t kbterm
for s in kb kb2 kb3 kh; do $T kill-session -t "=$s"; done
bars_py() {  # the ttop panes that are ttv or tth bars, and their sizes; "ok" or what went wrong
  /usr/bin/python3 -ISB -c 'import importlib.machinery as m, importlib.util as u, sys
l = m.SourceFileLoader("tls", sys.argv[1]); t = u.module_from_spec(u.spec_from_loader("tls", l)); l.exec_module(t)
t.cell_size = lambda server=None: (1, 2)   # no tmux here
right = lambda w, cmd: [(0, 0, 0, w - 26, 40, "sleep 600"), (1, w - 25, 0, 25, 40, cmd)]
bottom = lambda w, h, cmd: [(0, 0, 0, w, h - 11, "sleep 600"), (1, 0, h - 10, w, 10, cmd)]
corner = [(0, 0, 0, 80, 40, "sleep 600"), (1, 81, 0, 79, 30, "sleep 600"), (2, 81, 31, 79, 9, "/bin/ttop -h")]
cases = {"right, 160 x 40": (t.bar_targets(160, 40, right(160, "/bin/ttop -v")), {1: ("w", 25)}),
         "right, wide: 300 x 40": (t.bar_targets(300, 40, right(300, "/bin/ttop -v")), {1: ("w", 30)}),
         "right, with -f": (t.bar_targets(160, 40, right(160, "/bin/ttop -v -f")), {1: None}),
         "bottom, 120 x 40": (t.bar_targets(120, 40, bottom(120, 40, "ttop -h")), {1: ("h", 10)}),
         "bottom, taller than wide: 60 x 40": (t.bar_targets(60, 40, bottom(60, 40, "ttop -h")), {1: ("h", 12)}),
         "in a corner": (t.bar_targets(160, 40, corner), {2: None})}
bad = ["%s: %r" % (k, got) for k, (got, want) in cases.items() if got != want]
print("ok" if not bad else "; ".join(bad))' "$TLS"
}
check "bar sizes: ttv 25 columns, 30 in a wide window; tth 10 lines, 12 in a window taller than wide; -f or a corner keeps its size" \
  '[ "$(bars_py)" = ok ]'
# The hooks come back by themselves: an agent's report finds that the tmux
# server lacks them (as after an update of tls, or a new server) and adds them.
for h in client-attached client-session-changed session-window-changed after-select-pane pane-focus-in \
         window-layout-changed window-resized; do $T set-hook -gu "$h[42]"; done
for h in client-attached client-session-changed session-window-changed after-select-pane; do $T set-hook -gu "$h[43]"; done
$T set -gu @tls-hooks
$T new-session -d -s mk "sleep 600"
TMUX="$SOCK,1,0" TMUX_PANE="$($T display -p -t =mk: '#{pane_id}')" "$TLS" report id=mark-0001 agent=codex pid=$$ state=busy
check "an agent's report adds the hooks again to a tmux server that lacks them" \
  '$T show-hooks -gw | grep -q "^window-resized\[42\] .*relayout" && [ "$($T show-hooks -g | grep -cF "$TLS seen")" = 4 ] &&
   [ "$($T show-hooks -g | grep -cF "$TLS bars")" = 4 ] && [ -n "$($T show -gv @tls-hooks)" ]'
"$TLS" forget mark-0001; $T kill-session -t =mk

# Settings: defaults in tls, the settings file over them, an environment
# variable over both. The file in config/ is the one install.sh puts in place.
[ -f "$HERE/../config/tls.conf" ] &&
  check "config/tls.conf is what tls config --defaults prints" 'cmp -s <("$TLS" config --defaults) "$HERE/../config/tls.conf"'
printf '[ttv]\nwidth = 28\n' > "$TLS_CONFIG"
