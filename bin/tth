#!/bin/sh
# tth [WINDOW]: add a bar with ttop -h, 10 lines high and as wide as the
# window, at the bottom of this tmux window (or WINDOW), if it is 30 lines high
# or more: for a screen that is taller than wide. The panes there give up room
# in proportion to their heights. In a window that has a tth bar, it sets the
# bar back to 10 lines; a bar on the right (from ttv) moves to the bottom.
# The numbers are defaults: [tth] in ~/.config/tmux-agents/tls.conf.
# A regular file, not a symlink: dotfile syncers often skip symlinks.
exec "$(dirname "$(readlink -f "$0")")/tls" bar bottom "$@"
