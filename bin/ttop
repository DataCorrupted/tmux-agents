#!/bin/sh
# ttop [-v | -h] [-p] [-f]: tls's tmux sessions and AI agents, live and
# interactive, like top; -v vertical, -h horizontal, neither: by the window's
# shape; -p: n makes new sessions in the preset layout; -f: fit the tmux pane
# to the list. Up/Down select, Enter switches to the session, n new session,
# Del deletes, q quits; `ttop --help` for the rest.
# A regular file, not a symlink: dotfile syncers often skip symlinks.
exec "$(dirname "$(readlink -f "$0")")/tls" top "$@"
