#!/bin/sh
# ttop: tls's tmux sessions and AI agents, live and interactive, like top.
# Up/Down select, Enter switches to the session, n new session, Del deletes, q
# quits; `tls -h` for the rest. A regular file, not a symlink: dotfile syncers
# often skip symlinks.
exec "$(dirname "$(readlink -f "$0")")/tls" top "$@"
